module board_test;

import {String} from akikit::strings::string;
import {contains} from akikit::strings::string_search;
import {parse, to_string, array, as_array} from akikit::text::json;
import {eprintln} from akikit::logging;
import {str_of} from wire::fields;
import {Board, Refusal, kStallMillis} from orchestrator::board;

fn claude_usage(five: str, seven: str): String =>
  f"{{\"type\":\"usage\",\"meters\":[{{\"agent\":\"claude\",\"provider\":\"anthropic\",\"limits\":[{{\"name\":\"5 hours\",\"used\":{five}}},{{\"name\":\"7 days\",\"used\":{seven}}}]}}]}}";

fn claude_usage_at(five: str, seven: str, at: i32): String =>
  f"{{\"type\":\"usage\",\"meters\":[{{\"agent\":\"claude\",\"provider\":\"anthropic\",\"at\":{at},\"limits\":[{{\"name\":\"5 hours\",\"used\":{five}}},{{\"name\":\"7 days\",\"used\":{seven}}}]}}]}}";

fn take_all(var b&: Board, box_name: str): String {
  var all = String();
  for (let line& in b.take_outbox(box_name)) {
    all.push_str(line.as_str());
  }
  return all;
}

fn check(ok: bool, what: str, var failures&: i32): () {
  if (!ok) {
    eprintln(what);
    failures += 1;
  }
}

fn task_state(b&: Board, id: str): String {
  let t = b.task_json(id)!;
  var out = String();
  out.push_str(str_of(t, "state") ?? "");
  return out;
}

pub fn main(): i32 {
  var failures: i32 = 0;
  var b = Board();
  let none_images = array();
  let hello = parse("{\"type\":\"hello\",\"box\":\"forge\",\"host\":\"forge.lan\",\"agents\":[\"claude\"],\"projects\":[],\"running\":[]}")!;

  if (let _ = b.create_task("forge", "/src/dewy", "claude", "", "fix it", none_images, false, 1000)) {
    check(false, "an unknown box takes no task", failures);
  } else (let e) {
    check(e == Refusal::NoSuchBox, "unknown box", failures);
  }

  let _ = b.attach(hello, 1000);
  check(contains(to_string(b.boxes_json()).as_str(), "\"models\":{}"), "a box that lists no models has none", failures);
  if (let _ = b.create_task("forge", "/src/dewy", "codex", "", "fix it", none_images, false, 1000)) {
    check(false, "an agent the box lacks is refused", failures);
  }
  let id = b.create_task("forge", "/src/dewy", "claude", "", "fix the flaky test\nthen push", none_images, false, 1000)!;
  check(id.as_str() == "1", "ids count up", failures);

  let out = b.take_outbox("forge");
  check(out.len() == 1, "the turn waits in the outbox", failures);
  let turn = parse(out[0].as_str())!;
  check((str_of(turn, "type") ?? "") == "turn" && (str_of(turn, "turn") ?? "") == "t1", "a turn message", failures);
  check(b.take_outbox("forge").len() == 0, "the outbox empties", failures);

  let entry = parse("{\"type\":\"entry\",\"task\":\"1\",\"entry\":{\"id\":\"t1.x\",\"kind\":\"tool\",\"tool\":\"Bash\",\"detail\":\"npm test\",\"state\":\"running\"}}")!;
  b.apply("forge", entry, 2000);
  let state = b.state_json();
  let summary = to_string(state);
  check(contains(summary.as_str(), "\"activity\":\"Bash npm test\""), "a running tool is the activity", failures);

  let done = parse("{\"type\":\"entry\",\"task\":\"1\",\"entry\":{\"id\":\"t1.x\",\"state\":\"ok\"}}")!;
  b.apply("forge", done, 3000);
  let t = b.task_json("1")!;
  let text = to_string(t);
  check(contains(text.as_str(), "\"tool\":\"Bash\",\"detail\":\"npm test\",\"state\":\"ok\""), "entries merge by id", failures);
  check(contains(text.as_str(), "\"title\":\"fix the flaky test\""), "the title is the first line", failures);

  b.sweep(3000 + kStallMillis + 1);
  check(task_state(b, "1").as_str() == "stalled", "silence stalls a task", failures);
  b.apply("forge", parse("{\"type\":\"entry\",\"task\":\"1\",\"entry\":{\"id\":\"t1.y\",\"kind\":\"agent\",\"text\":\"Done.\"}}")!, 500000);
  check(task_state(b, "1").as_str() == "working", "news revives a stalled task", failures);

  b.apply("forge", parse("{\"type\":\"state\",\"task\":\"1\",\"state\":\"idle\"}")!, 500001);
  check(task_state(b, "1").as_str() == "idle", "a finished turn idles", failures);

  let seq = b.last_seq();
  let _ = b.steer("1", "now push", none_images, 600000);
  let frames = b.frames_since(seq)!;
  check(frames.len() >= 2, "steering emits the entry and the task", failures);

  // A worker that comes back without the task running fails it.
  b.detach("forge", 700000);
  let _ = b.attach(hello, 700001);
  check(task_state(b, "1").as_str() == "failed", "a lost turn fails", failures);

  // A session running in a terminal, as the worker lists it.
  if (let _ = b.attach_session("forge", "s-1", false, 800000)) {
    check(false, "an unlisted session is refused", failures);
  } else (let e) {
    check(e == Refusal::NoSuchSession, "unlisted session", failures);
  }
  b.apply("forge", parse("{\"type\":\"sessions\",\"sessions\":[{\"id\":\"s-1\",\"pid\":42,\"project\":\"/src/rx\",\"name\":\"rx-de\",\"state\":\"working\"}]}")!, 800001);
  check(contains(to_string(b.boxes_json()).as_str(), "\"name\":\"rx-de\""), "the box shows its sessions", failures);
  let _ = b.take_outbox("forge");
  let watched = b.attach_session("forge", "s-1", false, 800002)!;
  let w = to_string(b.task_json(watched.as_str())!);
  check(contains(w.as_str(), "\"project\":\"/src/rx\"") && contains(w.as_str(), "\"session\":\"s-1\""), "the task takes the session", failures);
  check(task_state(b, watched.as_str()).as_str() == "working", "a busy session is working", failures);
  let watch = b.take_outbox("forge");
  check(watch.len() == 1 && contains(watch[0].as_str(), "\"type\":\"watch\""), "the worker is told to watch", failures);
  check((b.attach_session("forge", "s-1", false, 800003)!).eq(watched), "attaching again finds the task", failures);
  check(b.take_outbox("forge").len() == 1, "and asks the worker to watch again", failures);

  b.apply("forge", parse("{\"type\":\"title\",\"task\":\"2\",\"title\":\"Rust port\"}")!, 800004);
  check(contains(to_string(b.task_json(watched.as_str())!).as_str(), "\"title\":\"Rust port\""), "the worker names the task", failures);

  let _ = b.take_outbox("forge");
  let wild = b.create_task("forge", "/src/dewy", "claude", "", "go", none_images, true, 850000)!;
  let turns = b.take_outbox("forge");
  check(turns.len() == 1 && contains(turns[0].as_str(), "\"yolo\":true"), "a yolo task's turn says so", failures);
  let _ = b.steer(wild.as_str(), "again", none_images, 850001);
  let later = b.take_outbox("forge");
  check(later.len() == 1 && contains(later[0].as_str(), "\"yolo\":true"), "and so does every later turn", failures);
  check(contains(to_string(b.task_json(wild.as_str())!).as_str(), "\"yolo\":true"), "the task shows it", failures);

  let newest = b.last_seq();
  check(b.frames_since(newest)!.len() == 0, "nothing after the newest change", failures);
  check(b.frames_since(newest + 5) == none, "a position past the newest resets", failures);

  // Images: the thread keeps their ids, the worker's turn gets their data.
  let _ = b.take_outbox("forge");
  let pictures = parse("[{\"id\":\"ab12\",\"type\":\"image/png\",\"data\":\"iVBORw0KGgo=\"}]")!;
  let shot = b.create_task("forge", "/src/dewy", "claude", "", "", pictures, false, 860000)!;
  let shown = to_string(b.task_json(shot.as_str())!);
  check(contains(shown.as_str(), "\"title\":\"Image\""), "an image alone is a task named Image", failures);
  check(contains(shown.as_str(), "\"images\":[{\"id\":\"ab12\",\"type\":\"image/png\"}]"), "the thread keeps the ids", failures);
  check(!contains(shown.as_str(), "iVBOR"), "and not the data", failures);
  let sent = b.take_outbox("forge");
  check(sent.len() == 1 && contains(sent[0].as_str(), "\"data\":\"iVBORw0KGgo=\""), "the turn carries the data", failures);

  // Models: a task runs the one picked, from those the box lists.
  let _ = b.attach(parse("{\"type\":\"hello\",\"box\":\"lab\",\"agents\":[\"opencode\"],\"models\":{\"opencode\":[\"opencode/big-pickle\",\"opencode-go/kimi-k3\"]},\"projects\":[],\"running\":[]}")!, 870000);
  check(contains(to_string(b.boxes_json()).as_str(), "\"models\":{\"opencode\":[\"opencode/big-pickle\""), "a box shows its models", failures);
  if (let _ = b.create_task("lab", "/src/dewy", "opencode", "gpt-9", "go", none_images, false, 870001)) {
    check(false, "a model the box lacks is refused", failures);
  } else (let e) {
    check(e == Refusal::UnknownModel, "unknown model", failures);
  }
  let picked = b.create_task("lab", "/src/dewy", "opencode", "opencode/big-pickle", "go", none_images, false, 870002)!;
  let first = b.take_outbox("lab");
  check(first.len() == 1 && contains(first[0].as_str(), "\"model\":\"opencode/big-pickle\""), "the turn runs the model", failures);
  check(contains(to_string(b.task_json(picked.as_str())!).as_str(), "\"model\":\"opencode/big-pickle\""), "the task shows it", failures);
  if (let _ = b.set_model(picked.as_str(), "nope/nope", 870003)) {
    check(false, "switching to an unknown model is refused", failures);
  }
  let _ = b.set_model(picked.as_str(), "opencode-go/kimi-k3", 870004);
  let _ = b.steer(picked.as_str(), "again", none_images, 870005);
  let next = b.take_outbox("lab");
  check(next.len() == 1 && contains(next[0].as_str(), "\"model\":\"opencode-go/kimi-k3\""), "later turns run the new model", failures);
  let _ = b.set_model(picked.as_str(), "", 870006);
  check(contains(to_string(b.task_json(picked.as_str())!).as_str(), "\"model\":\"\""), "empty is the default", failures);

  // Usage: a meter replaces the one for the same agent and provider.
  let _ = b.apply("lab", parse("{\"type\":\"usage\",\"meters\":[{\"agent\":\"codex\",\"provider\":\"openai\",\"limits\":[{\"name\":\"7 days\",\"used\":0.5}]},{\"agent\":\"opencode\",\"provider\":\"opencode-go\",\"spend\":[]}]}")!, 880000);
  let _ = b.apply("lab", parse("{\"type\":\"usage\",\"meters\":[{\"agent\":\"codex\",\"provider\":\"openai\",\"limits\":[{\"name\":\"7 days\",\"used\":0.75}]}]}")!, 880001);
  let lab = to_string(b.boxes_json());
  check(contains(lab.as_str(), "\"usage\":[{\"agent\":\"opencode\",\"provider\":\"opencode-go\",\"spend\":[]},{\"agent\":\"codex\",\"provider\":\"openai\",\"limits\":[{\"name\":\"7 days\",\"used\":0.75"),
        "the newest meter wins, the others stay", failures);
  var restored = Board();
  restored.restore_box(as_array(parse(lab.as_str())!)![1]);
  check(contains(to_string(restored.boxes_json()).as_str(), "\"used\":0.75"), "meters are saved with the box", failures);

  // Spend: a rise of a limit is split among the tasks that used tokens
  // since, by their tokens; each window on its own.
  let big = b.create_task("forge", "/src/dewy", "claude", "", "big", none_images, false, 890000)!;
  let small = b.create_task("forge", "/src/dewy", "claude", "", "small", none_images, false, 890000)!;
  let _ = b.apply("forge", parse(claude_usage("0.10", "0.40").as_str())!, 890001);
  let _ = b.apply("forge", parse(f"{{\"type\":\"spend\",\"task\":\"{big}\",\"provider\":\"anthropic\",\"tokens\":300,\"cost\":0.5}}".as_str())!, 890002);
  let _ = b.apply("forge", parse(f"{{\"type\":\"spend\",\"task\":\"{small}\",\"provider\":\"anthropic\",\"tokens\":100,\"cost\":0}}".as_str())!, 890003);
  let _ = b.apply("forge", parse(claude_usage("0.14", "0.40").as_str())!, 890004);
  let big_json = to_string(b.task_json(big.as_str())!);
  check(contains(big_json.as_str(), "\"spend\":{\"tokens\":300,\"cost\":0.5,\"share\":[{\"name\":\"5 hours\",\"used\":0.03"),
        "the big task gets three quarters of the rise", failures);
  check(contains(to_string(b.task_json(small.as_str())!).as_str(), "{\"name\":\"5 hours\",\"used\":0.01"),
        "the small task a quarter", failures);
  let _ = b.apply("forge", parse(claude_usage("0.14", "0.44").as_str())!, 890005);
  check(contains(to_string(b.task_json(big.as_str())!).as_str(), "{\"name\":\"7 days\",\"used\":0.03"),
        "the week rose later, on the same tokens", failures);
  let _ = b.apply("forge", parse(f"{{\"type\":\"spend\",\"task\":\"{small}\",\"provider\":\"anthropic\",\"tokens\":50,\"cost\":0}}".as_str())!, 890006);
  let _ = b.apply("forge", parse(claude_usage("0.02", "0.44").as_str())!, 890007);
  let _ = b.apply("forge", parse(claude_usage("0.05", "0.44").as_str())!, 890008);
  check(!contains(to_string(b.task_json(small.as_str())!).as_str(), "{\"name\":\"5 hours\",\"used\":0.04"),
        "a new window forgets the tokens before it", failures);
  let _ = b.apply("lab", parse(f"{{\"type\":\"spend\",\"task\":\"{big}\",\"provider\":\"anthropic\",\"tokens\":999,\"cost\":9}}".as_str())!, 890009);
  check(contains(to_string(b.task_json(big.as_str())!).as_str(), "\"tokens\":300,"), "another box cannot add to a task", failures);

  // A reading older than the known one changes nothing: no reset, no rise.
  let _ = b.apply("forge", parse(f"{{\"type\":\"spend\",\"task\":\"{big}\",\"provider\":\"anthropic\",\"tokens\":10,\"cost\":0}}".as_str())!, 890010);
  let _ = b.apply("forge", parse(claude_usage_at("0.05", "0.44", 20).as_str())!, 890011);
  let _ = b.apply("forge", parse(claude_usage_at("0.01", "0.44", 10).as_str())!, 890012);
  let _ = b.apply("forge", parse(claude_usage_at("0.07", "0.44", 30).as_str())!, 890013);
  check(contains(to_string(b.task_json(big.as_str())!).as_str(), "{\"name\":\"5 hours\",\"used\":0.05"),
        "a stale reading is not a reset", failures);
  check(contains(to_string(b.boxes_json()).as_str(), "\"used\":0.07"), "the newest reading stays", failures);

  // After a hello, the first reading is a baseline: the rise before it
  // happened while the box was away.
  let _ = b.attach(hello, 890014);
  let _ = b.apply("forge", parse(f"{{\"type\":\"spend\",\"task\":\"{big}\",\"provider\":\"anthropic\",\"tokens\":10,\"cost\":0}}".as_str())!, 890015);
  let _ = b.apply("forge", parse(claude_usage_at("0.50", "0.60", 40).as_str())!, 890016);
  check(!contains(to_string(b.task_json(big.as_str())!).as_str(), "{\"name\":\"7 days\",\"used\":0.19"),
        "the first reading after a hello is a baseline", failures);

  var saved = Board();
  saved.restore_task(b.task_json(big.as_str())!);
  check(contains(to_string(saved.task_json(big.as_str())!).as_str(), "\"tokens\":320,\"cost\":0.5"), "spend is saved", failures);

  // Power off: armed, a box turns off a minute after it is no longer busy.
  let _ = b.attach(parse("{\"type\":\"hello\",\"box\":\"head\",\"agents\":[\"claude\"],\"projects\":[],\"running\":[],\"poweroff\":false}")!, 895000);
  if (let _ = b.arm_power_off("head", true)) {
    check(false, "a box that cannot turn off is not armed", failures);
  } else (let e) {
    check(e == Refusal::CannotPowerOff, "cannot power off", failures);
  }
  let _ = b.attach(parse("{\"type\":\"hello\",\"box\":\"pc\",\"agents\":[\"claude\"],\"projects\":[],\"running\":[],\"poweroff\":true}")!, 895000);
  let job = b.create_task("pc", "/src/dewy", "claude", "", "long job", none_images, false, 895001)!;
  b.arm_power_off("pc", true)!;
  b.sweep(895002);
  check(contains(to_string(b.boxes_json()).as_str(), "\"poweroff\":{\"can\":true,\"armed\":true,\"at\":0,"), "armed, busy", failures);
  let _ = b.apply("pc", parse(f"{{\"type\":\"state\",\"task\":\"{job}\",\"state\":\"idle\"}}".as_str())!, 895003);
  b.sweep(895004);
  check(contains(to_string(b.boxes_json()).as_str(), "\"armed\":true,\"at\":955004"), "idle: the countdown starts", failures);
  let _ = b.apply("pc", parse("{\"type\":\"sessions\",\"sessions\":[{\"id\":\"s1\",\"state\":\"working\"}]}")!, 895005);
  b.sweep(895006);
  check(contains(to_string(b.boxes_json()).as_str(), "\"armed\":true,\"at\":0"), "a working terminal session stops it", failures);
  let _ = b.apply("pc", parse("{\"type\":\"sessions\",\"sessions\":[{\"id\":\"s1\",\"state\":\"idle\"}]}")!, 895007);
  b.sweep(895008);
  b.sweep(955007);
  check(!contains(take_all(b, "pc").as_str(), "poweroff"), "not before the minute is up", failures);
  var kept = Board();
  let boxes_now = parse(to_string(b.boxes_json()).as_str())!;
  for (let one& in as_array(boxes_now)!) {
    if ((str_of(one, "name") ?? "") == "pc") {
      kept.restore_box(one);
    }
  }
  check(contains(to_string(kept.boxes_json()).as_str(), "\"can\":true,\"armed\":true"), "arming is saved", failures);
  b.sweep(955008);
  check(contains(take_all(b, "pc").as_str(), "{\"type\":\"poweroff\"}"), "then it turns off", failures);
  check(contains(to_string(b.boxes_json()).as_str(), "\"armed\":false,\"at\":0"), "and is disarmed for when it is back", failures);

  // A task started, or the switch turned off, during the countdown keeps
  // the box on.
  b.arm_power_off("pc", true)!;
  b.sweep(960000);
  let again = b.create_task("pc", "/src/dewy", "claude", "", "one more", none_images, false, 960001)!;
  b.sweep(960002);
  check(contains(to_string(b.boxes_json()).as_str(), "\"armed\":true,\"at\":0"), "a new task stops the countdown", failures);
  let _ = b.apply("pc", parse(f"{{\"type\":\"state\",\"task\":\"{again}\",\"state\":\"idle\"}}".as_str())!, 960003);
  b.sweep(960004);
  b.arm_power_off("pc", false)!;
  b.sweep(1100000);
  check(!contains(take_all(b, "pc").as_str(), "poweroff"), "disarming stops it", failures);

  // An order the worker never got is dropped when it goes away.
  b.arm_power_off("pc", true)!;
  b.sweep(1100001);
  b.sweep(1200000);
  b.detach("pc", 1200001);
  let _ = b.attach(parse("{\"type\":\"hello\",\"box\":\"pc\",\"agents\":[\"claude\"],\"projects\":[],\"running\":[],\"poweroff\":true}")!, 1200002);
  check(!contains(take_all(b, "pc").as_str(), "poweroff"), "no late power-off after a reconnect", failures);

  // A worker that may no longer turn the box off disarms it.
  b.arm_power_off("pc", true)!;
  let _ = b.attach(parse("{\"type\":\"hello\",\"box\":\"pc\",\"agents\":[\"claude\"],\"projects\":[],\"running\":[],\"poweroff\":false}")!, 1200003);
  check(contains(to_string(b.boxes_json()).as_str(), "\"can\":false,\"armed\":false"), "no longer allowed, no longer armed", failures);
  let _ = b.apply("pc", parse("{\"type\":\"poweroff\",\"error\":\"systemctl poweroff failed on the box.\"}")!, 1200004);
  check(contains(to_string(b.boxes_json()).as_str(), "\"error\":\"systemctl poweroff failed on the box.\""), "a failure shows", failures);

  b.detach("forge", 900000);
  check(!contains(to_string(b.boxes_json()).as_str(), "rx-de"), "an offline box lists no sessions", failures);
  return failures;
}
