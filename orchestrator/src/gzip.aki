// Gzip for replies. zlib's compress2 writes a zlib stream: a 2-byte header,
// the deflate data, and a 4-byte Adler-32. Gzip wraps the same deflate data
// in its own 10-byte header and a trailer of the CRC-32 and the length.

module orchestrator::gzip;

import {Vector, new, resize} from akibase::containers::vector;
import {crc32} from akibase::hashing::crc;

extern("compressBound") fn c_compress_bound(n: u64): u64;
extern("compress2") fn c_compress2(dest: *var u8, dest_len: *var u64, src: *const u8, src_len: u64, level: i32): i32;

comptime let kLevel: i32 = 6;

pub fn gzip(data: bytes): Vector<u8>? {
  var z = new::<u8>();
  var n: u64 = 0;
  unsafe {
    n = c_compress_bound(#data as u64);
  }
  resize(z, n as usize, 0u8);
  var ok = false;
  unsafe {
    ok = c_compress2(@ptr(z.as_slice_var()), &raw var n, @ptr(data), #data as u64, kLevel) == 0;
  }
  if (!ok || n < 6) {
    return none;
  }
  var out = new::<u8>();
  out.reserve(n as usize + 12);
  for (let b in [0x1fu8, 0x8b, 8, 0, 0, 0, 0, 0, 0, 3]) {
    out.push(b);
  }
  for (let i in 2usize..(n as usize - 4)) {
    out.push(z[i]);
  }
  push_le(out, crc32(data));
  push_le(out, #data as u32);
  return out;
}

fn push_le(var out&: Vector<u8>, v: u32): () {
  for (let shift in [0u32, 8, 16, 24]) {
    out.push(((v >> shift) & 0xff) as u8);
  }
}
