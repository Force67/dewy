// Worker connections. A worker dials in, says hello with the token, then
// streams its lines while the dock hands it the lines waiting in its box's
// outbox. Reads time out often so the outbox never waits long.

module orchestrator::dock;

import {String} from akikit::strings::string;
import {List} from akikit::containers::list;
import {TcpStream} from akikit::net::tcp;
import {Arc} from akikit::memory::arc;
import {Json, object, array, set, push, get, as_array, text} from akikit::text::json;
import {milliseconds, seconds, now} from akikit::time::time;
import {eprintln} from akikit::logging;
import {LineStream} from wire::line_stream;
import {str_of, put} from wire::fields;
import {decode} from wire::base64;
import {store} from orchestrator::images;
import {Board} from orchestrator::board;
import {Hub, now_ms} from orchestrator::hub;

pub struct DockConnection : Send {
  pub var stream: TcpStream
  pub var hub: Arc<Hub>
}

pub fn serve_worker(c: DockConnection) {
  var stream = c.stream;
  let hub& = c.hub.get();
  let _ = stream.set_read_timeout(milliseconds(250));
  let _ = stream.set_write_timeout(seconds(10));
  var link = LineStream(stream);
  let hello = read_hello(link, hub.token) else {
    return;
  };
  let name = hub.board.with(fn(b: &var Board): String => b.attach(hello, now_ms()));
  hub.changed.notify_all();
  eprintln(f"dock: {name} attached".as_str());
  while (true) {
    if (let got = link.read()) {
      if (let msg = got) {
        var m = msg;
        keep_images(hub.data, m);
        hub.board.with(fn(b: &var Board): () => b.apply(name, m, now_ms()));
        hub.changed.notify_all();
      }
    } else {
      break;
    }
    let out = hub.board.with(fn(b: &var Board): List<String> => b.take_outbox(name));
    var sent = true;
    for (let line& in out) {
      if (let _ = link.send_text(line)) {
      } else {
        sent = false;
      }
    }
    if (!sent) {
      break;
    }
  }
  hub.board.with(fn(b: &var Board): () => b.detach(name, now_ms()));
  hub.changed.notify_all();
  eprintln(f"dock: {name} left".as_str());
}

// The first line must be a hello with the right token, within ten seconds.
fn read_hello(var link&: LineStream, token: str): Json? {
  let start = now();
  while (start.elapsed() < seconds(10)) {
    let got = link.read() else {
      return none;
    };
    if (let j = got) {
      let ok = (str_of(j, "type") ?? "") == "hello" && (str_of(j, "token") ?? "") == token && #token > 0;
      return ok ? j : none;
    }
  }
  return none;
}

// An entry carries the images an agent looked at as base64; they are stored
// here, and the entry keeps their ids, so the board needs no I/O.
fn keep_images(data_dir: str, var msg&: Json) {
  if ((str_of(msg, "type") ?? "") != "entry") {
    return;
  }
  let entry& = get(msg, "entry") else { return; };
  var e = entry.clone();
  let list = as_array(get(e, "images") ?? Json::Null) else {
    return;
  };
  var kept = array();
  for (let img& in list) {
    let media = str_of(img, "type") ?? "";
    let data = decode(str_of(img, "data") ?? "") else {
      continue;
    };
    if (let id = store(data_dir, data.as_slice(), media)) {
      var o = object();
      set(o, "id", text(id));
      set(o, "type", text(media));
      push(kept, o);
    }
  }
  put(e, "images", kept);
  put(msg, "entry", e);
}
