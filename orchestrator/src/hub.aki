// What every connection shares: the board behind its lock, a signal that
// fires after each change, and the token clients must present.

module orchestrator::hub;

import {String} from akibase::strings::base_string;
import {Mutex} from akibase::threading::mutex;
import {Condvar} from akibase::threading::condition_variable;
import {unix_time_milliseconds} from akibase::time::time;
import {Board} from orchestrator::board;

pub struct Hub : Send {
  pub let board: Mutex<Board>
  pub let changed: Condvar
  pub let token: String
}

pub fn now_ms(): i64 => unix_time_milliseconds();
