// What every connection shares: the board behind its lock, a signal that
// fires after each change, the token clients must present, and the epoch,
// which changes with every start, since the feed's seq starts over.

module orchestrator::hub;

import {String} from akikit::strings::string;
import {Mutex} from akikit::threading::mutex;
import {Condvar} from akikit::threading::condition_variable;
import {unix_time_milliseconds} from akikit::time::time;
import {Board} from orchestrator::board;

pub struct Hub : Send {
  pub let board: Mutex<Board>
  pub let changed: Condvar
  pub let token: String
  pub let epoch: i64
  // Where tasks and images are kept.
  pub let data: String
}

pub fn now_ms(): i64 => unix_time_milliseconds();
