// The board on disk: data/tasks/<id>.json per task with its thread, and
// data/boxes.json. Only tasks that changed since the last save are written,
// each through a temporary file and a rename.

module orchestrator::snapshot;

import {String, from_str} from akikit::strings::string;
import {List} from akikit::containers::list;
import {parse, to_string, as_array} from akikit::text::json;
import {atomic_write} from wire::files;
import {read_file} from akikit::filesystem::file_util;
import {create_directories, list_directory} from akikit::filesystem::directory;
import {join} from akikit::filesystem::path;
import {ends_with} from akikit::strings::string_search;
import {Board} from orchestrator::board;

// Files ready to write, taken from the board under its lock.
pub struct Pending : Send {
  pub var names: List<String> = List()
  pub var texts: List<String> = List()
}

pub fn prepare(var board&: Board): Pending {
  var p = Pending {};
  for (let id& in board.take_dirty_tasks()) {
    if (let t = board.task_json(id)) {
      p.names.push(f"tasks/{id}.json");
      p.texts.push(to_string(t));
    }
  }
  if (board.take_dirty_boxes()) {
    p.names.push(from_str("boxes.json"));
    p.texts.push(to_string(board.boxes_json()));
  }
  return p;
}

pub fn write(dir: str, p&: Pending): bool {
  var ok = true;
  for (let i in 0usize..p.names.len()) {
    let path = join(dir, p.names[i].as_str());
    if (let _ = atomic_write(path, p.texts[i])) { continue; }
    ok = false;
  }
  return ok;
}

pub fn load(dir: str, var board&: Board): usize {
  let tasks_dir = join(dir, "tasks");
  let _ = create_directories(tasks_dir);
  if (let text = read_file(join(dir, "boxes.json").as_str())) {
    if (let j = parse(text)) {
      if (let boxes = as_array(j)) {
        for (let b& in boxes) {
          board.restore_box(b);
        }
      }
    }
  }
  var count: usize = 0;
  let names = list_directory(tasks_dir) ?? List::<String>();
  for (let name& in names) {
    if (!ends_with(name, ".json")) {
      continue;
    }
    if (let text = read_file(join(tasks_dir, name).as_str())) {
      if (let j = parse(text)) {
        board.restore_task(j);
        count += 1;
      }
    }
  }
  return count;
}
