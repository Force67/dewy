// The board on disk: data/tasks/<id>.json per task with its thread, and
// data/boxes.json. Only tasks that changed since the last save are written,
// each through a temporary file and a rename.

module orchestrator::snapshot;

import {String, from_str} from akibase::strings::base_string;
import {Vector, new} from akibase::containers::vector;
import {parse, to_string, as_array} from akibase::text::json;
import {read_file, write_file, rename_file} from akibase::filesystem::file_util;
import {create_directories, list_directory} from akibase::filesystem::directory;
import {join} from akibase::filesystem::path;
import {ends_with} from akibase::strings::string_search;
import {Board} from orchestrator::board;

// Files ready to write, taken from the board under its lock.
pub struct Pending : Send {
  pub var names: Vector<String>
  pub var texts: Vector<String>
}

pub fn prepare(var board&: Board): Pending {
  var p = Pending { names: new::<String>(), texts: new::<String>() };
  for (let id& in board.take_dirty_tasks()) {
    if (let t = board.task_json(id.as_str())) {
      var name = from_str("tasks/");
      name.push_str(id.as_str());
      name.push_str(".json");
      p.names.push(name);
      p.texts.push(to_string(t));
    }
  }
  if (board.take_dirty_boxes()) {
    p.names.push(from_str("boxes.json"));
    p.texts.push(to_string(board.boxes_json()));
  }
  return p;
}

pub fn write(dir: str, p&: Pending): bool {
  var ok = true;
  for (let i in 0usize..p.names.len()) {
    let path = join(dir, p.names[i].as_str());
    var temp = path.clone();
    temp.push_str(".tmp");
    if (let _ = write_file(temp.as_str(), p.texts[i].as_str())) {
      if (let _ = rename_file(temp.as_str(), path.as_str())) {
        continue;
      }
    }
    ok = false;
  }
  return ok;
}

pub fn load(dir: str, var board&: Board): usize {
  let tasks_dir = join(dir, "tasks");
  let _ = create_directories(tasks_dir.as_str());
  if (let text = read_file(join(dir, "boxes.json").as_str())) {
    if (let j = parse(text.as_str())) {
      if (let boxes = as_array(j)) {
        for (let b& in boxes) {
          board.restore_box(b);
        }
      }
    }
  }
  var count: usize = 0;
  let names = list_directory(tasks_dir.as_str()) ?? new::<String>();
  for (let name& in names) {
    if (!ends_with(name.as_str(), ".json")) {
      continue;
    }
    if (let text = read_file(join(tasks_dir.as_str(), name.as_str()).as_str())) {
      if (let j = parse(text.as_str())) {
        board.restore_task(j);
        count += 1;
      }
    }
  }
  return count;
}
