// The app's HTTP API. Every route but /api/health wants the token as
// "Authorization: Bearer <token>". Each connection carries one request;
// /api/stream keeps its connection for server-sent events.
//
//   GET  /api/state                   boxes and task summaries, with the feed position
//   GET  /api/tasks/<id>              one task with its thread
//   POST /api/tasks                   {box, project, agent, text, images, yolo}: start a task
//   POST /api/tasks/<id>/messages     {text, images}: steer a task
//   POST /api/tasks/<id>/stop
//   POST /api/tasks/<id>/archive      {archived}
//   POST /api/sessions/attach         {box, session, yolo}: follow a terminal session as a task
//   POST /api/images                  an image's bytes, with its Content-Type: {id}
//   GET  /api/images/<id>             the image's bytes
//   GET  /api/stream?since=<seq>&epoch=<epoch>
//                                     changes after seq as server-sent events

module orchestrator::api;

import {String} from akibase::strings::base_string;
import {TcpStream} from akibase::net::tcp;
import {Request, finish, header, kMaxHead, path_part, read_error_status, read_request, send_response, error_body}
  from akibase::net::http;
import {gzip} from orchestrator::gzip;
import {kMaxImage, kMaxImages, store, load} from orchestrator::images;
import {encode} from wire::base64;
import {SharedPointer} from akibase::memory::shared_pointer;
import {Json, object, array, set, push, get, as_array, as_str, text, number, boolean, parse, to_string} from akibase::text::json;
import {utf8_lossy} from akibase::text::code_convert;
import {split} from akibase::strings::string_util;
import {contains, find, strip_prefix, trim} from akibase::strings::string_search;
import {parse_u64} from akibase::strings::string_to_number;
import {seconds} from akibase::time::time;
import {str_of, bool_of} from wire::fields;
import {Board, Refusal, refusal_message} from orchestrator::board;
import {Hub, now_ms} from orchestrator::hub;
import {stream_changes} from orchestrator::stream;

// An image upload is the largest body.
comptime let kMaxBody: usize = kMaxImage + (64 << 10);
comptime let kMaxImageCount: usize = 4;
comptime let kGzipFrom: usize = 1024;

pub struct AppConnection : Send {
  pub var stream: TcpStream
  pub var hub: SharedPointer<Hub>
}

struct Reply {
  pub var status: u32
  pub var body: String
}

fn json_reply(status: u32, j&: Json): Reply => Reply { status, body: to_string(j) };

fn error_reply(status: u32, message: str): Reply {
  var o = object();
  set(o, "error", text(message));
  return json_reply(status, o);
}

fn refusal_reply(r: Refusal): Reply {
  let status: u32 = match (r) {
    Refusal::NoSuchBox => 404,
    Refusal::NoSuchTask => 404,
    Refusal::NoSuchSession => 404,
    Refusal::BoxOffline => 409,
    Refusal::Empty => 400,
    Refusal::UnknownAgent => 400,
  };
  return error_reply(status, refusal_message(r));
}

fn ok_reply(): Reply {
  var o = object();
  set(o, "ok", boolean(true));
  return json_reply(200, o);
}

pub fn serve_app(c: AppConnection): () {
  var stream = c.stream;
  let hub& = c.hub.get();
  let _ = stream.set_read_timeout(seconds(10));
  let _ = stream.set_write_timeout(seconds(10));
  let r = read_request(stream, kMaxHead, kMaxBody) else (let e) {
    let status = read_error_status(e);
    if (status != 0) {
      let body = error_body(status);
      let _ = send_response(stream, status, "text/plain; charset=utf-8", body.as_bytes(), [], true);
    }
    return;
  };
  let path = path_part(r.target.as_str());
  if (path != "/api/health" && !authorized(r, hub.token.as_str())) {
    send(stream, error_reply(401, "missing or wrong token"), false);
    return;
  }
  if (r.method.eq_str("GET") && path == "/api/stream") {
    // A client from before this start, which names no epoch or an old one,
    // resumes from a seq that means something else now.
    let epoch = query_u64(r.target.as_str(), "epoch=");
    let current = epoch == 0 || epoch == hub.epoch as u64;
    stream_changes(stream, hub, query_u64(r.target.as_str(), "since="), current);
    return;
  }
  if (r.method.eq_str("GET")) {
    if (let id = strip_prefix(path, "/api/images/")) {
      serve_image(stream, hub, id);
      return;
    }
  }
  let reply = route(r, path, hub);
  send(stream, reply, contains(r.header("Accept-Encoding") ?? "", "gzip"));
}

// Images never change, so the app keeps them for good.
fn serve_image(var stream&: TcpStream, hub&: Hub, id: str): () {
  let img = load(hub.data.as_str(), id) else {
    send(stream, error_reply(404, "no such image"), false);
    return;
  };
  let extra = [header("Cache-Control", "private, max-age=31536000, immutable")];
  let _ = send_response(stream, 200, img.media.as_str(), img.data.as_slice(), extra, true);
  finish(stream);
}

fn upload_image(r&: Request, hub&: Hub): Reply {
  var media = r.header("Content-Type") ?? "";
  if (let at = find(media, ";")) {
    media = media[..at];
  }
  let id = store(hub.data.as_str(), r.body.as_slice(), trim(media)) else {
    return error_reply(400, "not a JPEG, PNG, WebP, or GIF image of at most 4 MiB");
  };
  var o = object();
  set(o, "id", text(id.as_str()));
  return json_reply(201, o);
}

// The images a message names, with their data for the worker.
fn message_images(body&: Json, hub&: Hub): Json ! Reply {
  var out = array();
  let ids = as_array(get(body, "images") ?? Json::Null) else {
    return out;
  };
  if (#ids > kMaxImageCount) {
    return fail error_reply(400, "at most 4 images");
  }
  var total: usize = 0;
  for (let v& in ids) {
    let img = load(hub.data.as_str(), as_str(v) ?? "") else {
      return fail error_reply(400, "no such image");
    };
    total += img.data.len();
    if (total > kMaxImages) {
      return fail error_reply(413, "the images are more than 4.5 MiB together");
    }
    var o = object();
    set(o, "id", text(as_str(v) ?? ""));
    set(o, "type", text(img.media.as_str()));
    set(o, "data", text(encode(img.data.as_slice()).as_str()));
    push(out, o);
  }
  return out;
}

fn send(var stream&: TcpStream, reply: Reply, gz: bool): () {
  // Threads are long and repetitive, so gzip shrinks them several times over.
  if (gz && reply.body.len() >= kGzipFrom) {
    if (let packed = gzip(reply.body.as_bytes())) {
      let extra = [header("Content-Encoding", "gzip")];
      let _ = send_response(stream, reply.status, "application/json", packed.as_slice(), extra, true);
      finish(stream);
      return;
    }
  }
  let _ = send_response(stream, reply.status, "application/json", reply.body.as_bytes(), [], true);
  finish(stream);
}

fn authorized(r&: Request, token: str): bool {
  let given = strip_prefix(r.header("Authorization") ?? "", "Bearer ") else {
    return false;
  };
  if (#given != #token || #token == 0) {
    return false;
  }
  var diff: u8 = 0;
  for (let i in 0usize..#token) {
    diff = diff | (given[i] as u8 ^ token[i] as u8);
  }
  return diff == 0;
}

fn query_u64(target: str, key: str): u64 {
  let at = find(target, key) else {
    return 0;
  };
  var value = target[at + #key..];
  if (let end = find(value, "&")) {
    value = value[..end];
  }
  return parse_u64(value) ?? 0;
}

fn body_json(r&: Request): Json? => parse(utf8_lossy(r.body.as_slice()).as_str());

fn route(r&: Request, path: str, hub&: Hub): Reply {
  let parts = split(path, "/");
  // "/api/tasks/7/stop" splits into "", "api", "tasks", "7", "stop".
  let n = parts.len();
  let get = r.method.eq_str("GET");
  let post = r.method.eq_str("POST");
  if (path == "/api/health") {
    return ok_reply();
  }
  if (get && path == "/api/state") {
    var j = hub.board.with(fn(b: &var Board): Json => b.state_json());
    set(j, "epoch", number(hub.epoch as f64));
    return json_reply(200, j);
  }
  if (post && path == "/api/tasks") {
    return start_task(r, hub);
  }
  if (post && path == "/api/images") {
    return upload_image(r, hub);
  }
  if (post && path == "/api/sessions/attach") {
    return attach_session(r, hub);
  }
  if (n < 4 || parts[1] != "api" || parts[2] != "tasks") {
    return error_reply(404, "no such route");
  }
  let id = parts[3];
  if (get && n == 4) {
    // The feed position the thread was read at, so a client can tell which
    // streamed changes it already holds.
    let found = hub.board.with(fn(b: &var Board): Json? {
      var j = b.task_json(id) else {
        return none;
      };
      set(j, "seq", number(b.last_seq() as f64));
      return j;
    });
    if (let j = found) {
      return json_reply(200, j);
    }
    return refusal_reply(Refusal::NoSuchTask);
  }
  if (!post || n != 5) {
    return error_reply(404, "no such route");
  }
  let now = now_ms();
  let action = parts[4];
  let body = body_json(r) ?? object();
  // Images load before the board's lock is taken.
  let images = message_images(body, hub) else (let e) {
    return e;
  };
  let result = hub.board.with(fn(b: &var Board): () ! Refusal {
    if (action == "messages") {
      return b.steer(id, str_of(body, "text") ?? "", images, now);
    }
    if (action == "stop") {
      return b.stop(id, now);
    }
    if (action == "archive") {
      return b.archive(id, bool_of(body, "archived") ?? true, now);
    }
    return fail Refusal::NoSuchTask;
  });
  hub.changed.notify_all();
  if (let _ = result) {
    return ok_reply();
  } else (let e) {
    return refusal_reply(e);
  }
}

fn start_task(r&: Request, hub&: Hub): Reply {
  let body = body_json(r) else {
    return error_reply(400, "the body is not JSON");
  };
  let now = now_ms();
  let images = message_images(body, hub) else (let e) {
    return e;
  };
  let created = hub.board.with(fn(b: &var Board): String ! Refusal => b.create_task(
    str_of(body, "box") ?? "", str_of(body, "project") ?? "", str_of(body, "agent") ?? "", str_of(body, "text") ?? "",
    images, bool_of(body, "yolo") ?? false, now));
  return created_reply(created, hub);
}

fn attach_session(r&: Request, hub&: Hub): Reply {
  let body = body_json(r) else {
    return error_reply(400, "the body is not JSON");
  };
  let now = now_ms();
  let attached = hub.board.with(fn(b: &var Board): String ! Refusal => b.attach_session(
    str_of(body, "box") ?? "", str_of(body, "session") ?? "", bool_of(body, "yolo") ?? false, now));
  return created_reply(attached, hub);
}

fn created_reply(created: String ! Refusal, hub&: Hub): Reply {
  hub.changed.notify_all();
  if (let id = created) {
    let found = hub.board.with(fn(b: &var Board): Json? => b.task_json(id.as_str()));
    if (let j = found) {
      return json_reply(201, j);
    }
  } else (let e) {
    return refusal_reply(e);
  }
  return error_reply(500, "the task vanished");
}
