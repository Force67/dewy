// Everything the orchestrator knows: the boxes, their tasks and each
// task's thread of entries. Every change lands in a numbered feed that app
// streams replay from, and commands for a box wait in its outbox until the
// box's connection picks them up. No I/O happens here; callers pass the
// time in.

module orchestrator::board;

import {String, from_str} from akikit::strings::string;
import {List} from akikit::containers::list;
import {Deque} from akikit::containers::deque;
import {Json, object, array, text, number, boolean, set, push, get, as_array, as_str, parse, to_string} from akikit::text::json;
import {put, str_of, string_of, num_of, bool_of, merge} from wire::fields;
import {first_line} from wire::clip;
import {trim, contains} from akikit::strings::string_search;
import {replace} from akikit::algorithm;

// An armed box turns off this long after its last task ended.
pub comptime let kPowerOffMillis: i64 = 60000;
// A task that says nothing for this long while working is stalled.
pub comptime let kStallMillis: i64 = 180000;
comptime let kFeedLength: usize = 4000;
comptime let kPreviewBytes: usize = 200;

pub enum TaskState { Working, Idle, Stalled, Failed, Stopped }

pub fn state_name(s: TaskState): str<'static> => match (s) {
  TaskState::Working => "working",
  TaskState::Idle => "idle",
  TaskState::Stalled => "stalled",
  TaskState::Failed => "failed",
  TaskState::Stopped => "stopped",
};

pub fn state_named(name: str): TaskState? => match (name) {
  "working" => TaskState::Working,
  "idle" => TaskState::Idle,
  "stalled" => TaskState::Stalled,
  "failed" => TaskState::Failed,
  "stopped" => TaskState::Stopped,
  _ => none,
};

// Why the board turned a request down.
pub enum Refusal { NoSuchBox, BoxOffline, NoSuchTask, NoSuchSession, Empty, UnknownAgent, UnknownModel, CannotPowerOff }

pub fn refusal_message(r: Refusal): str<'static> => match (r) {
  Refusal::NoSuchBox => "no such box",
  Refusal::BoxOffline => "the box is offline",
  Refusal::NoSuchTask => "no such task",
  Refusal::NoSuchSession => "the box lists no such session",
  Refusal::Empty => "the message is empty",
  Refusal::UnknownAgent => "the box has no such agent",
  Refusal::UnknownModel => "the box has no such model",
  Refusal::CannotPowerOff => "the box cannot turn itself off",
};

pub struct Task : Send {
  pub var id: String
  pub var box_name: String
  pub var project: String
  pub var agent: String
  // provider/model, empty for the agent's default.
  pub var model: String
  pub var title: String
  pub var session: String
  pub var preview: String
  // What the agent is doing right now, such as "Bash npm test".
  pub var activity: String
  pub var state: TaskState
  pub var archived: bool
  // Its turns run without asking for permissions.
  pub var yolo: bool
  pub var created: i64
  pub var updated: i64
  pub var turns: u32
  // What its turns used, as the worker reported it, and its estimated
  // share of each limit as JSON text: [{"name", "used"}] (see
  // docs/adr/0006-task-usage.md).
  pub var tokens: f64
  pub var cost: f64
  pub var share: String
  // Cumulative reports per turn make worker output replay idempotent.
  pub var turn_spend: String
  // Entries as JSON text, since akikit's Json is not Send, and their ids.
  pub var entries: List<String>
  pub var entry_ids: List<String>
}

pub struct Box : Send {
  pub var name: String
  pub var host: String
  pub var os: String
  // JSON text: an array of agent names, an array of {name, path}, an object.
  pub var agents: String
  pub var projects: String
  // JSON text: the models the box lists, by agent.
  pub var models: String
  // JSON text: the box's meters, one per agent and provider (see
  // docs/adr/0005-usage-limits.md).
  pub var usage: String
  pub var stats: String
  // JSON text: the Claude Code sessions running in terminals on the box, as
  // the worker last listed them.
  pub var sessions: String
  pub var online: bool
  pub var last_seen: i64
  // Lines for the box's worker, oldest first.
  pub var outbox: List<String>
  // Providers with a meter since the worker's hello. The first one after
  // it is only a baseline: the rise since the one before happened unseen.
  pub var measured: List<String>
  // Its user may turn it off; armed, it turns off when its tasks are done,
  // at `off_at` once they are (see docs/adr/0007-power-off-when-done.md).
  pub var can_power_off: bool
  pub var armed: bool
  pub var off_at: i64
  // Why the box did not turn off when told to, until it is armed again.
  pub var power_error: String
}

// Tokens a task used against one limit window of a box's provider since
// that window last rose.
struct Pending : Send {
  pub var box_name: String
  pub var provider: String
  pub var window: String
  pub var task: String
  pub var tokens: f64
}

struct Change : Send {
  pub let seq: u64
  pub let frame: String
}

pub struct Board : Send {
  var tasks: List<Task> = List()
  var boxes: List<Box> = List()
  var feed: Deque<Change> = Deque()
  var seq: u64 = 0
  var next_id: u64 = 1
  var dirty_tasks: List<String> = List()
  var dirty_boxes: bool = false
  var pending: List<Pending> = List()

  pub fn Board(): Board;
  pub fn last_seq(self&): u64;
  pub fn create_task(var self&, box_name: str, project: str, agent: str, model: str, prompt: str, images&: Json, yolo: bool,
    now: i64): String ! Refusal;
  pub fn attach_session(var self&, box_name: str, session: str, yolo: bool, now: i64): String ! Refusal;
  pub fn steer(var self&, id: str, prompt: str, images&: Json, now: i64): () ! Refusal;
  pub fn stop(var self&, id: str, now: i64): () ! Refusal;
  pub fn archive(var self&, id: str, archived: bool, now: i64): () ! Refusal;
  pub fn set_model(var self&, id: str, model: str, now: i64): () ! Refusal;
  pub fn arm_power_off(var self&, box_name: str, armed: bool): () ! Refusal;
  pub fn attach(var self&, hello&: Json, now: i64): String;
  pub fn detach(var self&, name: str, now: i64);
  pub fn apply(var self&, box_name: str, msg&: Json, now: i64);
  pub fn sweep(var self&, now: i64);
  pub fn take_outbox(var self&, box_name: str): List<String>;
  pub fn frames_since(self&, seq: u64): List<String>?;
  pub fn take_dirty_tasks(var self&): List<String>;
  pub fn take_dirty_boxes(var self&): bool;
  pub fn state_json(self&): Json;
  pub fn task_json(self&, id: str): Json?;
  pub fn boxes_json(self&): Json;
  pub fn restore_task(var self&, j&: Json);
  pub fn restore_box(var self&, j&: Json);
  fn find_task(self&, id: str): usize?;
  fn find_box(self&, name: str): usize?;
  fn has_model(self&, b: usize, agent: str, model: str): bool;
  fn send_turn(var self&, i: usize, prompt: str, images&: Json, now: i64);
  fn put_entry(var self&, i: usize, entry: Json, now: i64);
  fn set_state(var self&, i: usize, state: TaskState, now: i64);
  fn emit(var self&, kind: str, data&: Json);
  fn touch_task(var self&, i: usize);
  fn spend(var self&, box_name: str, msg&: Json);
  fn busy(self&, b: usize): bool;
  fn attribute(var self&, box_name: str, fresh&: Json);
  fn touch_box(var self&, b: usize);
}

fn Board::Board(): Board => Board {};

fn Board::last_seq(self&): u64 => self.seq;

fn Board::find_task(self&, id: str): usize? {
  for (let i in 0usize..self.tasks.len()) {
    if (self.tasks[i].id == id) {
      return i;
    }
  }
  return none;
}

fn Board::find_box(self&, name: str): usize? {
  for (let i in 0usize..self.boxes.len()) {
    if (self.boxes[i].name == name) {
      return i;
    }
  }
  return none;
}

fn has_text(list&: Json, value: str): bool {
  let items = as_array(list) else {
    return false;
  };
  for (let item& in items) {
    if (let s = as_str(item)) {
      if (s == value) {
        return true;
      }
    }
  }
  return false;
}

fn listed(obj&: Json, key: str, value: str): bool {
  let list = get(obj, key) else {
    return false;
  };
  return has_text(list, value);
}

fn Board::create_task(var self&, box_name: str, project: str, agent: str, model: str, prompt: str, images&: Json, yolo: bool,
  now: i64): String ! Refusal {
  let b = self.find_box(box_name) else {
    return fail Refusal::NoSuchBox;
  };
  if (!self.boxes[b].online) {
    return fail Refusal::BoxOffline;
  }
  if (!has_text(parse(self.boxes[b].agents.as_str()) ?? Json::Null, agent)) {
    return fail Refusal::UnknownAgent;
  }
  if (!self.has_model(b, agent, model)) {
    return fail Refusal::UnknownModel;
  }
  if (#trim(prompt) == 0 && image_count(images) == 0) {
    return fail Refusal::Empty;
  }
  var id = String();
  id.push_u64(self.next_id);
  self.next_id += 1;
  var title = from_str(first_line(prompt, 120));
  if (#trim(title) == 0) {
    title = from_str("Image");
  }
  self.tasks.push(Task {
    id: id.clone(), box_name: from_str(box_name), project: from_str(project), agent: from_str(agent), model: from_str(model),
    title, session: String(), preview: String(), activity: String(),
    state: TaskState::Working, archived: false, yolo, created: now, updated: now, turns: 0, tokens: 0.0, cost: 0.0,
    share: from_str("[]"), turn_spend: from_str("{}"), entries: List::<String>(), entry_ids: List::<String>()
  });
  self.send_turn(self.tasks.len() - 1, prompt, images, now);
  return id;
}

// Follows a Claude Code session the box lists as running in a terminal.
// The task starts with the session and no turns of its own; the worker
// mirrors the session into it. Attaching again returns the same task and
// asks again, for a worker that lost its watch; one still watching
// ignores it.
fn Board::attach_session(var self&, box_name: str, session: str, yolo: bool, now: i64): String ! Refusal {
  let b = self.find_box(box_name) else {
    return fail Refusal::NoSuchBox;
  };
  if (!self.boxes[b].online) {
    return fail Refusal::BoxOffline;
  }
  var watch = object();
  set(watch, "type", text("watch"));
  set(watch, "session", text(session));
  for (let t& in self.tasks) {
    if (#session > 0 && t.session == session && t.box_name == box_name) {
      set(watch, "task", text(t.id));
      self.boxes[b].outbox.push(to_string(watch));
      return t.id.clone();
    }
  }
  let listed = parse(self.boxes[b].sessions.as_str()) ?? array();
  var found: Json? = none;
  if (let all = as_array(listed)) {
    for (let s& in all) {
      if ((str_of(s, "id") ?? "") == session) {
        found = s.clone();
      }
    }
  }
  let s = found else {
    return fail Refusal::NoSuchSession;
  };
  var id = String();
  id.push_u64(self.next_id);
  self.next_id += 1;
  let working = (str_of(s, "state") ?? "") == "working";
  var title = from_str(str_of(s, "name") ?? "");
  if (title.is_empty()) {
    title = from_str("Terminal session");
  }
  self.tasks.push(Task {
    id: id.clone(), box_name: from_str(box_name), project: string_of(s, "project"), agent: from_str("claude"),
    model: String(), title, session: from_str(session), preview: String(), activity: String(),
    state: working ? TaskState::Working : TaskState::Idle, archived: false, yolo, created: now, updated: now, turns: 0,
    tokens: 0.0, cost: 0.0, share: from_str("[]"), turn_spend: from_str("{}"), entries: List::<String>(), entry_ids: List::<String>()
  });
  self.touch_task(self.tasks.len() - 1);
  set(watch, "task", text(id));
  self.boxes[b].outbox.push(to_string(watch));
  return id;
}

fn Board::steer(var self&, id: str, prompt: str, images&: Json, now: i64): () ! Refusal {
  let i = self.find_task(id) else {
    return fail Refusal::NoSuchTask;
  };
  if (#trim(prompt) == 0 && image_count(images) == 0) {
    return fail Refusal::Empty;
  }
  let b = self.find_box(self.tasks[i].box_name.as_str()) else {
    return fail Refusal::NoSuchBox;
  };
  if (!self.boxes[b].online) {
    return fail Refusal::BoxOffline;
  }
  self.tasks[i].archived = false;
  self.send_turn(i, prompt, images, now);
  return ();
}

fn image_count(images&: Json): usize {
  if (let list = as_array(images)) {
    return #list;
  }
  return 0;
}

// Records the user's message and queues a turn for the task's box. The
// worker runs it after any turn still in flight. `images` hold their data,
// which goes to the worker; the thread keeps their ids.
fn Board::send_turn(var self&, i: usize, prompt: str, images&: Json, now: i64) {
  self.tasks[i].turns += 1;
  var turn = from_str("t");
  turn.push_u64(self.tasks[i].turns as u64);

  var entry = object();
  var entry_id = turn.clone();
  entry_id.push_str(".you");
  set(entry, "id", text(entry_id));
  set(entry, "kind", text("user"));
  set(entry, "text", text(prompt));
  set(entry, "at", number(now as f64));
  if (image_count(images) > 0) {
    var shown = array();
    for (let img& in as_array(images)!) {
      var o = object();
      set(o, "id", text(str_of(img, "id") ?? ""));
      set(o, "type", text(str_of(img, "type") ?? ""));
      push(shown, o);
    }
    set(entry, "images", shown);
  }
  self.put_entry(i, entry, now);

  var msg = object();
  set(msg, "type", text("turn"));
  set(msg, "task", text(self.tasks[i].id.as_str()));
  set(msg, "turn", text(turn));
  set(msg, "agent", text(self.tasks[i].agent.as_str()));
  set(msg, "project", text(self.tasks[i].project.as_str()));
  set(msg, "session", text(self.tasks[i].session.as_str()));
  set(msg, "text", text(prompt));
  set(msg, "yolo", boolean(self.tasks[i].yolo));
  set(msg, "model", text(self.tasks[i].model.as_str()));
  if (image_count(images) > 0) {
    set(msg, "images", images.clone());
  }
  if (let b = self.find_box(self.tasks[i].box_name.as_str())) {
    self.boxes[b].outbox.push(to_string(msg));
  }
  self.set_state(i, TaskState::Working, now);
}

fn Board::stop(var self&, id: str, now: i64): () ! Refusal {
  let i = self.find_task(id) else {
    return fail Refusal::NoSuchTask;
  };
  var msg = object();
  set(msg, "type", text("stop"));
  set(msg, "task", text(id));
  if (let b = self.find_box(self.tasks[i].box_name.as_str())) {
    self.boxes[b].outbox.push(to_string(msg));
  }
  self.set_state(i, TaskState::Stopped, now);
  return ();
}

// The turns after run on `model`; empty for the agent's default.
fn Board::set_model(var self&, id: str, model: str, now: i64): () ! Refusal {
  let i = self.find_task(id) else {
    return fail Refusal::NoSuchTask;
  };
  let b = self.find_box(self.tasks[i].box_name.as_str()) else {
    return fail Refusal::NoSuchBox;
  };
  if (!self.has_model(b, self.tasks[i].agent.as_str(), model)) {
    return fail Refusal::UnknownModel;
  }
  self.tasks[i].model = from_str(model);
  self.tasks[i].updated = now;
  self.touch_task(i);
  return ();
}

// A worker's report of what a task used: it adds to the task, and waits as
// pending tokens for the next rise of each limit its provider has on the box.
fn Board::spend(var self&, box_name: str, msg&: Json) {
  let i = self.find_task(str_of(msg, "task") ?? "") else {
    return;
  };
  if (self.tasks[i].box_name != box_name) {
    return;
  }
  var tokens = num_of(msg, "tokens") ?? 0.0;
  var cost = num_of(msg, "cost") ?? 0.0;
  let turn = str_of(msg, "turn") ?? "";
  if (#turn > 0) {
    var reports = parse(self.tasks[i].turn_spend.as_str()) ?? object();
    let old_tokens = num_of(get(reports, turn) ?? Json::Null, "tokens") ?? 0.0;
    let old_cost = num_of(get(reports, turn) ?? Json::Null, "cost") ?? 0.0;
    var total = object();
    set(total, "tokens", number(tokens > old_tokens ? tokens : old_tokens));
    set(total, "cost", number(cost > old_cost ? cost : old_cost));
    put(reports, turn, total);
    self.tasks[i].turn_spend = to_string(reports);
    tokens = tokens > old_tokens ? tokens - old_tokens : 0.0;
    cost = cost > old_cost ? cost - old_cost : 0.0;
  }
  if (tokens <= 0.0 && cost <= 0.0) { return; }
  self.tasks[i].tokens += tokens;
  self.tasks[i].cost += cost;
  self.touch_task(i);
  let provider = str_of(msg, "provider") ?? "";
  let b = self.find_box(box_name) else {
    return;
  };
  if (#provider == 0 || tokens <= 0.0) {
    return;
  }
  let meters = as_array(parse(self.boxes[b].usage.as_str()) ?? Json::Null) else {
    return;
  };
  for (let m& in meters) {
    if ((str_of(m, "provider") ?? "") != provider) {
      continue;
    }
    for (let l& in as_array(get(m, "limits") ?? Json::Null) ?? []) {
      let window = str_of(l, "name") ?? "";
      var found = false;
      for (var p& in self.pending) {
        if (p.box_name == box_name && p.provider == provider && p.window == window
            && p.task.eq(self.tasks[i].id)) {
          p.tokens += tokens;
          found = true;
        }
      }
      if (!found) {
        self.pending.push(Pending {
          box_name: from_str(box_name), provider: from_str(provider), window: from_str(window),
          task: self.tasks[i].id.clone(), tokens
        });
      }
    }
  }
}

// Splits every rise of a limit, from the box's meters to the fresh ones,
// among the tasks with pending tokens for it; a fall is a new window.
fn Board::attribute(var self&, box_name: str, fresh&: Json) {
  let b = self.find_box(box_name) else {
    return;
  };
  let known = parse(self.boxes[b].usage.as_str()) ?? Json::Null;
  for (let f& in as_array(get(fresh, "meters") ?? Json::Null) ?? []) {
    let provider = str_of(f, "provider") ?? "";
    var baselined = false;
    for (let p& in self.boxes[b].measured) {
      if (p == provider) {
        baselined = true;
      }
    }
    if (!baselined) {
      self.boxes[b].measured.push(from_str(provider));
      continue;
    }
    for (let old& in as_array(known) ?? []) {
      // An older reading than the one known says nothing new.
      if (!same_meter(old, f) || (num_of(f, "at") ?? 0.0) < (num_of(old, "at") ?? 0.0)) {
        continue;
      }
      for (let l& in as_array(get(f, "limits") ?? Json::Null) ?? []) {
        let window = str_of(l, "name") ?? "";
        let before = limit_used(old, window) else {
          continue;
        };
        let rise = (num_of(l, "used") ?? 0.0) - before;
        if (rise > 1e-9) {
          var total: f64 = 0.0;
          for (let p& in self.pending) {
            if (p.box_name == box_name && p.provider == provider && p.window == window) {
              total += p.tokens;
            }
          }
          var shares = List::<(String, f64)>();
          for (let p& in self.pending) {
            if (total > 0.0 && p.box_name == box_name && p.provider == provider
                && p.window == window) {
              shares.push((p.task.clone(), rise * p.tokens / total));
            }
          }
          for (let sh& in shares) {
            if (let i = self.find_task(sh.0.as_str())) {
              self.tasks[i].share = add_share(self.tasks[i].share.as_str(), window, sh.1);
              self.touch_task(i);
            }
          }
        }
        if (rise > 1e-9 || rise < -1e-9) {
          var k: usize = 0;
          while (k < self.pending.len()) {
            let p& = self.pending[k];
            if (p.box_name == box_name && p.provider == provider && p.window == window) {
              let _ = self.pending.remove(k);
            } else {
              k += 1;
            }
          }
        }
      }
    }
  }
}

fn limit_used(meter&: Json, window: str): f64? {
  for (let l& in as_array(get(meter, "limits") ?? Json::Null) ?? []) {
    if ((str_of(l, "name") ?? "") == window) {
      return num_of(l, "used");
    }
  }
  return none;
}

// A task's shares with `amount` more of `window`.
fn add_share(known: str, window: str, amount: f64): String {
  var out = array();
  var found = false;
  for (let s& in as_array(parse(known) ?? Json::Null) ?? []) {
    var used = num_of(s, "used") ?? 0.0;
    if ((str_of(s, "name") ?? "") == window) {
      used += amount;
      found = true;
    }
    var o = object();
    set(o, "name", text(str_of(s, "name") ?? ""));
    set(o, "used", number(used));
    push(out, o);
  }
  if (!found) {
    var o = object();
    set(o, "name", text(window));
    set(o, "used", number(amount));
    push(out, o);
  }
  return to_string(out);
}

fn same_meter(a&: Json, b&: Json): bool =>
  (str_of(a, "agent") ?? "") == (str_of(b, "agent") ?? "") && (str_of(a, "provider") ?? "") == (str_of(b, "provider") ?? "");

// The box's meters with those of a usage line in place of the ones for the
// same agent and provider.
fn merge_meters(known: str, msg&: Json): String {
  let fresh = as_array(get(msg, "meters") ?? Json::Null) else {
    return from_str(known);
  };
  var out = array();
  if (let old = as_array(parse(known) ?? Json::Null)) {
    for (let m& in old) {
      var replaced = false;
      for (let f& in fresh) {
        if (same_meter(m, f) && (num_of(f, "at") ?? 0.0) >= (num_of(m, "at") ?? 0.0)) {
          replaced = true;
        }
      }
      if (!replaced) {
        push(out, m.clone());
      }
    }
  }
  for (let f& in fresh) {
    var older = false;
    if (let old = as_array(parse(known) ?? Json::Null)) {
      for (let m& in old) {
        if (same_meter(m, f) && (num_of(f, "at") ?? 0.0) < (num_of(m, "at") ?? 0.0)) {
          older = true;
        }
      }
    }
    if (!older) {
      push(out, f.clone());
    }
  }
  return to_string(out);
}

fn usage_text(j&: Json): String {
  let usage& = get(j, "usage") else { return from_str("[]"); };
  if (usage is Json::Arr(_)) { return to_string(usage); }
  return from_str("[]");
}

// A hello or saved box from before models were listed has none.
fn models_text(j&: Json): String {
  if (let m = get(j, "models")) {
    match (m) {
      Json::Obj(let _members&) => {
        return to_string(m);
      }
      _ => {}
    }
  }
  return from_str("{}");
}

fn Board::has_model(self&, b: usize, agent: str, model: str): bool {
  if (#model == 0) {
    return true;
  }
  let models = parse(self.boxes[b].models.as_str()) ?? Json::Null;
  return listed(models, agent, model);
}

fn Board::archive(var self&, id: str, archived: bool, now: i64): () ! Refusal {
  let i = self.find_task(id) else {
    return fail Refusal::NoSuchTask;
  };
  self.tasks[i].archived = archived;
  self.tasks[i].updated = now;
  self.touch_task(i);
  return ();
}

// A worker said hello. Tasks it was running before it went away and no
// longer runs have failed. Returns the box name.
fn Board::attach(var self&, hello&: Json, now: i64): String {
  let name = str_of(hello, "box") ?? "unnamed";
  let b = self.find_box(name) ?? self.boxes.len();
  if (b == self.boxes.len()) {
    self.boxes.push(Box {
      name: from_str(name), host: String(), os: String(), agents: from_str("[]"), projects: from_str("[]"),
      models: from_str("{}"), usage: from_str("[]"), stats: from_str("{}"), sessions: from_str("[]"), online: false, last_seen: now, outbox: List::<String>(),
      measured: List::<String>(), can_power_off: false, armed: false, off_at: 0,
      power_error: String()
    });
  }
  self.boxes[b].host = string_of(hello, "host");
  self.boxes[b].os = string_of(hello, "os");
  self.boxes[b].agents = to_string(get(hello, "agents") ?? Json::Null);
  self.boxes[b].projects = to_string(get(hello, "projects") ?? Json::Null);
  self.boxes[b].models = models_text(hello);
  self.boxes[b].sessions = from_str("[]");
  self.boxes[b].online = true;
  self.boxes[b].measured = List::<String>();
  self.boxes[b].can_power_off = bool_of(hello, "poweroff") ?? false;
  self.boxes[b].off_at = 0;
  // Armed but no longer allowed, the switch would be out of reach.
  if (!self.boxes[b].can_power_off) {
    self.boxes[b].armed = false;
  }
  self.boxes[b].last_seen = now;
  self.touch_box(b);

  for (let i in 0usize..self.tasks.len()) {
    let t& = self.tasks[i];
    let live = t.state == TaskState::Working || t.state == TaskState::Stalled;
    if (live && t.box_name == name && !listed(hello, "running", t.id)) {
      var note = object();
      var note_id = from_str("lost.");
      note_id.push_i64(now);
      set(note, "id", text(note_id));
      set(note, "kind", text("error"));
      set(note, "text", text("The worker restarted while this task was running."));
      set(note, "at", number(now as f64));
      self.put_entry(i, note, now);
      self.set_state(i, TaskState::Failed, now);
    }
  }
  return from_str(name);
}

fn Board::detach(var self&, name: str, now: i64) {
  if (let b = self.find_box(name)) {
    self.boxes[b].online = false;
    self.boxes[b].sessions = from_str("[]");
    self.boxes[b].last_seen = now;
    // A power-off the worker never got must not reach it on its return.
    var k: usize = 0;
    while (k < self.boxes[b].outbox.len()) {
      if (contains(self.boxes[b].outbox[k].as_str(), "\"type\":\"poweroff\"")) {
        let _ = self.boxes[b].outbox.remove(k);
      } else {
        k += 1;
      }
    }
    self.touch_box(b);
  }
}

// A line from a box's worker: an entry, a state change, a session id, or
// the box's stats.
fn Board::apply(var self&, box_name: str, msg&: Json, now: i64) {
  let kind = str_of(msg, "type") ?? "";
  if (kind == "spend") {
    self.spend(box_name, msg);
    return;
  }
  if (kind == "usage") {
    if (let b = self.find_box(box_name)) {
      self.attribute(box_name, msg);
      self.boxes[b].usage = merge_meters(self.boxes[b].usage.as_str(), msg);
      self.touch_box(b);
    }
    return;
  }
  if (kind == "poweroff") {
    if (let b = self.find_box(box_name)) {
      self.boxes[b].power_error = string_of(msg, "error");
      self.touch_box(b);
    }
    return;
  }
  if (kind == "stats") {
    if (let b = self.find_box(box_name)) {
      self.boxes[b].stats = to_string(get(msg, "stats") ?? Json::Null);
      self.boxes[b].last_seen = now;
      self.touch_box(b);
    }
    return;
  }
  if (kind == "sessions") {
    if (let b = self.find_box(box_name)) {
      self.boxes[b].sessions = to_string(get(msg, "sessions") ?? Json::Null);
      self.touch_box(b);
    }
    return;
  }
  let i = self.find_task(str_of(msg, "task") ?? "") else {
    return;
  };
  if (self.tasks[i].box_name != box_name) {
    return;
  }
  if (kind == "entry") {
    if (let e = get(msg, "entry")) {
      self.put_entry(i, e.clone(), now);
      if (self.tasks[i].state == TaskState::Stalled) {
        self.set_state(i, TaskState::Working, now);
      }
    }
  } else if (kind == "session") {
    self.tasks[i].session = string_of(msg, "session");
    self.touch_task(i);
  } else if (kind == "title") {
    self.tasks[i].title = from_str(first_line(str_of(msg, "title") ?? "", 120));
    self.touch_task(i);
  } else if (kind == "state") {
    let state = state_named(str_of(msg, "state") ?? "") else {
      return;
    };
    // A stop the user asked for wins over the turn's own ending.
    if (self.tasks[i].state == TaskState::Stopped && state != TaskState::Working) {
      return;
    }
    self.set_state(i, state, now);
  }
}

// Adds an entry, or merges it into the entry with the same id.
fn Board::put_entry(var self&, i: usize, entry: Json, now: i64) {
  let id = string_of(entry, "id");
  var at: usize? = none;
  for (let k in 0usize..self.tasks[i].entry_ids.len()) {
    if (self.tasks[i].entry_ids[k].eq(id)) {
      at = k;
    }
  }
  var e = entry;
  if (let k = at) {
    var old = parse(self.tasks[i].entries[k].as_str()) ?? object();
    merge(old, e);
    e = old;
    self.tasks.at_var(i).entries.set(k, to_string(e));
  } else {
    self.tasks.at_var(i).entries.push(to_string(e));
    self.tasks.at_var(i).entry_ids.push(id);
  }

  var t& = self.tasks.at_var(i);
  t.updated = now;
  let kind = str_of(e, "kind") ?? "";
  let body = str_of(e, "text") ?? "";
  if (kind == "agent" && #body > 0) {
    t.preview = from_str(first_line(body, kPreviewBytes));
  }
  if (kind == "tool") {
    if ((str_of(e, "state") ?? "") == "running") {
      var activity = string_of(e, "tool");
      activity.push_c8(' ');
      activity.push_str(first_line(str_of(e, "detail") ?? "", kPreviewBytes));
      t.activity = activity;
    } else {
      t.activity = String();
    }
  }

  var data = object();
  set(data, "task", text(t.id));
  set(data, "entry", e);
  self.emit("entry", data);
  self.touch_task(i);
}

fn Board::set_state(var self&, i: usize, state: TaskState, now: i64) {
  self.tasks[i].state = state;
  self.tasks[i].updated = now;
  if (state != TaskState::Working && state != TaskState::Stalled) {
    self.tasks[i].activity = String();
  }
  self.touch_task(i);
}

fn Board::sweep(var self&, now: i64) {
  for (let i in 0usize..self.tasks.len()) {
    if (self.tasks[i].state == TaskState::Working && now - self.tasks[i].updated > kStallMillis) {
      self.tasks[i].state = TaskState::Stalled;
      self.touch_task(i);
    }
  }
  // Armed boxes: count down once idle, stop counting when busy again.
  for (let b in 0usize..self.boxes.len()) {
    if (!self.boxes[b].armed || !self.boxes[b].online || !self.boxes[b].can_power_off) {
      continue;
    }
    if (self.busy(b)) {
      if (self.boxes[b].off_at != 0) {
        self.boxes[b].off_at = 0;
        self.touch_box(b);
      }
    } else if (self.boxes[b].off_at == 0) {
      self.boxes[b].off_at = now + kPowerOffMillis;
      self.touch_box(b);
    } else if (now >= self.boxes[b].off_at) {
      var msg = object();
      set(msg, "type", text("poweroff"));
      self.boxes[b].outbox.push(to_string(msg));
      // Disarmed, so the box stays on once it is back.
      self.boxes[b].armed = false;
      self.boxes[b].off_at = 0;
      self.touch_box(b);
    }
  }
}

// A box is busy while one of its tasks works, stalled or not, or one of the
// Claude Code sessions in its terminals does.
fn Board::busy(self&, b: usize): bool {
  let name = self.boxes[b].name.as_str();
  for (let t& in self.tasks) {
    if (t.box_name == name && (t.state == TaskState::Working || t.state == TaskState::Stalled)) {
      return true;
    }
  }
  for (let s& in as_array(parse(self.boxes[b].sessions.as_str()) ?? Json::Null) ?? []) {
    if ((str_of(s, "state") ?? "") == "working") {
      return true;
    }
  }
  return false;
}

fn Board::arm_power_off(var self&, box_name: str, armed: bool): () ! Refusal {
  let b = self.find_box(box_name) else {
    return fail Refusal::NoSuchBox;
  };
  if (armed && !self.boxes[b].can_power_off) {
    return fail Refusal::CannotPowerOff;
  }
  self.boxes[b].armed = armed;
  self.boxes[b].off_at = 0;
  self.boxes[b].power_error = String();
  self.touch_box(b);
  return ();
}

fn Board::take_outbox(var self&, box_name: str): List<String> {
  let b = self.find_box(box_name) else {
    return List::<String>();
  };
  return replace(self.boxes.at_var(b).outbox, List::<String>());
}

// The SSE frames after seq, or none when the feed no longer reaches back
// that far and the client must reload the state.
fn Board::frames_since(self&, seq: u64): List<String>? {
  var out = List::<String>();
  // A position past the newest change comes from before a restart.
  if (seq > self.seq) {
    return none;
  }
  if (let first = self.feed.front()) {
    if (first.seq > seq + 1) {
      return none;
    }
  }
  for (let c& in self.feed) {
    if (c.seq > seq) {
      out.push(c.frame.clone());
    }
  }
  return out;
}

fn Board::take_dirty_tasks(var self&): List<String> {
  return replace(self.dirty_tasks, List::<String>());
}

fn Board::take_dirty_boxes(var self&): bool {
  let out = self.dirty_boxes;
  self.dirty_boxes = false;
  return out;
}

fn Board::emit(var self&, kind: str, data&: Json) {
  self.seq += 1;
  var frame = from_str("id: ");
  frame.push_u64(self.seq);
  frame.push_str("\nevent: ");
  frame.push_str(kind);
  frame.push_str("\ndata: ");
  frame.push_str(to_string(data).as_str());
  frame.push_str("\n\n");
  self.feed.push_back(Change { seq: self.seq, frame });
  if (self.feed.len() > kFeedLength) {
    let _ = self.feed.pop_front();
  }
}

fn Board::touch_task(var self&, i: usize) {
  let summary = summary_json(self.tasks[i]);
  self.emit("task", summary);
  for (let id& in self.dirty_tasks) {
    if (id.eq(self.tasks[i].id)) {
      return;
    }
  }
  self.dirty_tasks.push(self.tasks[i].id.clone());
}

fn Board::touch_box(var self&, b: usize) {
  let j = box_json(self.boxes[b]);
  self.emit("box", j);
  self.dirty_boxes = true;
}

fn summary_json(t&: Task): Json {
  var o = object();
  set(o, "id", text(t.id));
  set(o, "box", text(t.box_name));
  set(o, "project", text(t.project));
  set(o, "agent", text(t.agent));
  set(o, "model", text(t.model));
  set(o, "title", text(t.title));
  set(o, "session", text(t.session));
  set(o, "preview", text(t.preview));
  set(o, "activity", text(t.activity));
  set(o, "state", text(state_name(t.state)));
  set(o, "archived", boolean(t.archived));
  set(o, "yolo", boolean(t.yolo));
  set(o, "created", number(t.created as f64));
  set(o, "updated", number(t.updated as f64));
  set(o, "turns", number(t.turns as f64));
  var spend = object();
  set(spend, "tokens", number(t.tokens));
  set(spend, "cost", number(t.cost));
  set(spend, "share", parse(t.share) ?? array());
  set(o, "spend", spend);
  return o;
}

fn box_json(b&: Box): Json {
  var o = object();
  set(o, "name", text(b.name));
  set(o, "host", text(b.host));
  set(o, "os", text(b.os));
  set(o, "online", boolean(b.online));
  set(o, "lastSeen", number(b.last_seen as f64));
  set(o, "agents", parse(b.agents) ?? array());
  set(o, "projects", parse(b.projects) ?? array());
  set(o, "models", parse(b.models) ?? object());
  set(o, "usage", parse(b.usage) ?? array());
  var power = object();
  set(power, "can", boolean(b.can_power_off));
  set(power, "armed", boolean(b.armed));
  set(power, "at", number(b.off_at as f64));
  set(power, "error", text(b.power_error));
  set(o, "poweroff", power);
  set(o, "stats", parse(b.stats) ?? object());
  set(o, "sessions", parse(b.sessions) ?? array());
  return o;
}

fn Board::boxes_json(self&): Json {
  var out = array();
  for (let b& in self.boxes) {
    push(out, box_json(b));
  }
  return out;
}

fn Board::state_json(self&): Json {
  var tasks = array();
  for (let t& in self.tasks) {
    push(tasks, summary_json(t));
  }
  var o = object();
  set(o, "seq", number(self.seq as f64));
  set(o, "boxes", self.boxes_json());
  set(o, "tasks", tasks);
  return o;
}

// A task with its whole thread; also the form it is saved in.
fn Board::task_json(self&, id: str): Json? {
  let i = self.find_task(id) else {
    return none;
  };
  var o = summary_json(self.tasks[i]);
  var entries = array();
  for (let e& in self.tasks[i].entries) {
    push(entries, parse(e) ?? Json::Null);
  }
  set(o, "entries", entries);
  set(o, "turnSpend", parse(self.tasks[i].turn_spend.as_str()) ?? object());
  return o;
}

fn Board::restore_task(var self&, j&: Json) {
  let id = string_of(j, "id");
  if (let n = parse_id(id)) {
    if (n >= self.next_id) {
      self.next_id = n + 1;
    }
  }
  // A task that was working stays so; its worker's next hello fails it if
  // the turn died meanwhile.
  let state = state_named(str_of(j, "state") ?? "") ?? TaskState::Idle;
  var entries = List::<String>();
  var entry_ids = List::<String>();
  if (let items = as_array(get(j, "entries") ?? Json::Null)) {
    for (let e& in items) {
      entries.push(to_string(e));
      entry_ids.push(string_of(e, "id"));
    }
  }
  var tokens: f64 = 0.0;
  var cost: f64 = 0.0;
  var share = from_str("[]");
  if (let spent = get(j, "spend")) {
    tokens = num_of(spent, "tokens") ?? 0.0;
    cost = num_of(spent, "cost") ?? 0.0;
    if (let list = get(spent, "share")) {
      share = to_string(list);
    }
  }
  self.tasks.push(Task {
    id, box_name: string_of(j, "box"), project: string_of(j, "project"), agent: string_of(j, "agent"),
    model: string_of(j, "model"), title: string_of(j, "title"), session: string_of(j, "session"), preview: string_of(j, "preview"),
    activity: String(), state, archived: bool_of(j, "archived") ?? false, yolo: bool_of(j, "yolo") ?? false,
    created: (num_of(j, "created") ?? 0.0) as i64, updated: (num_of(j, "updated") ?? 0.0) as i64,
    turns: (num_of(j, "turns") ?? 0.0) as u32, tokens, cost, share,
    turn_spend: to_string(get(j, "turnSpend") ?? object()), entries, entry_ids
  });
}

fn Board::restore_box(var self&, j&: Json) {
  self.boxes.push(Box {
    name: string_of(j, "name"), host: string_of(j, "host"), os: string_of(j, "os"),
    agents: to_string(get(j, "agents") ?? Json::Null), projects: to_string(get(j, "projects") ?? Json::Null),
    models: models_text(j), usage: usage_text(j), stats: from_str("{}"), sessions: from_str("[]"), online: false, last_seen: (num_of(j, "lastSeen") ?? 0.0) as i64,
    outbox: List::<String>(), measured: List::<String>(), can_power_off: power_flag(j, "can"),
    armed: power_flag(j, "armed"), off_at: 0, power_error: String()
  });
}

fn power_flag(j&: Json, key: str): bool {
  if (let power = get(j, "poweroff")) {
    return bool_of(power, key) ?? false;
  }
  return false;
}

fn parse_id(s: str): u64? {
  if (#s == 0) {
    return none;
  }
  var n: u64 = 0;
  for (let c in s) {
    if (c < '0' || c > '9') {
      return none;
    }
    n = n * 10 + (c as u64 - '0' as u64);
  }
  return n;
}
