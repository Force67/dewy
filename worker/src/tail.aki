// A file another process appends to, read line by line as it grows.
// Reads use a descriptor and lseek for transcript positioning: past the
// end, read(2) returns 0 until more is written.

module worker::tail;

import {String, with_nul} from akikit::strings::string;
import {List, extend, to_list} from akikit::containers::list;
import {utf8_lossy} from akikit::text::code_convert;

extern("open") fn c_open(path: *const c8, flags: i32): i32;
extern("read") fn c_read(fd: i32, p: *var byte, n: usize): i64;
extern("close") fn c_close(fd: i32): i32;
extern("lseek") fn c_lseek(fd: i32, offset: i64, whence: i32): i64;

comptime let kReadOnly: i32 = 0;

pub struct Tail : Send {
  var fd: i32
  var buf: List<byte> = List()
  var head: usize = 0

  fn Tail(fd: i32): Tail;
  pub fn next_line(var self&): String?;
  pub fn skip_to_end(var self&);
  pub fn final_line(var self&): String?;
  fn ~Tail();
}

pub fn open_tail(path: str): Tail? {
  let c = with_nul(path);
  var fd: i32 = -1;
  unsafe {
    fd = c_open(@ptr(c.as_str()), kReadOnly);
  }
  if (fd < 0) {
    return none;
  }
  return Tail(fd);
}

fn Tail::Tail(fd: i32): Tail => Tail { fd };

// Skips what the file holds so far.
fn Tail::skip_to_end(var self&) {
  unsafe {
    let _ = c_lseek(self.fd, 0, 2);
  }
  self.buf = List::<byte>();
  self.head = 0;
}

// The next whole line without its newline, or none until more is written.
// A line still being written stays buffered.
fn Tail::next_line(var self&): String? {
  while (true) {
    for (let i in self.head..#self.buf) {
      if (self.buf[i] == b'\n') {
        let line = utf8_lossy(self.buf.as_slice()[self.head..i]);
        self.head = i + 1;
        return line;
      }
    }
    if (self.head > 0) {
      self.buf = to_list(self.buf.as_slice()[self.head..]);
      self.head = 0;
    }
    var chunk = [b'\0'; 65536];
    var n: i64 = 0;
    unsafe {
      n = c_read(self.fd, @ptr(chunk), 65536);
    }
    if (n <= 0) {
      return none;
    }
    extend(self.buf, chunk[..n as usize]);
  }
  return none;
}

// After the writer exits, a final line need not have a trailing newline.
fn Tail::final_line(var self&): String? {
  if (self.head == self.buf.len()) { return none; }
  let line = utf8_lossy(self.buf.as_slice()[self.head..]);
  self.buf.clear();
  self.head = 0;
  return line;
}

fn Tail::~Tail() {
  if (self.fd >= 0) {
    unsafe {
      let _ = c_close(self.fd);
    }
  }
}

// The last `n` bytes of a file, read rather than mapped: a mapped file
// that shrinks kills the process.
pub fn last_bytes(path: str, n: usize): List<byte>? {
  let c = with_nul(path);
  var fd: i32 = -1;
  unsafe {
    fd = c_open(@ptr(c.as_str()), kReadOnly);
  }
  if (fd < 0) {
    return none;
  }
  var out = List::<byte>();
  var chunk = [b'\0'; 65536];
  unsafe {
    let size = c_lseek(fd, 0, 2);
    let start = size > n as i64 ? size - n as i64 : 0;
    if (size >= 0 && c_lseek(fd, start, 0) >= 0) {
      while (true) {
        let got = c_read(fd, @ptr(chunk), 65536);
        if (got <= 0) {
          break;
        }
        extend(out, chunk[..got as usize]);
      }
    }
    let _ = c_close(fd);
  }
  return out;
}
