// Follows a Claude Code session running in a terminal: mirrors its
// transcript into the task, and whether it is busy into the task's state.
// The crew counts a watch as the task's running turn, so a message for the
// task waits on it. Then, or when the task is stopped, the watch ends the
// terminal's process, which frees the session for a turn to resume.

module worker::watch;

import {String, from_str} from akikit::strings::string;
import {Json, parse, object, set, text} from akikit::text::json;
import {Arc} from akikit::memory::arc;
import {Atomic} from akikit::threading::atomic;
import {List} from akikit::containers::list;
import {milliseconds, sleep} from akikit::time::time;
import {str_of} from wire::fields;
import {said, tool_finished, entry_message} from worker::entry;
import {Transcript} from worker::transcript;
import {read_terminal} from worker::claude_code;
import {Ended, Outbox, SharedOutbox, post, state_message} from worker::turn;
import {TerminalSession, alive, reread, end_session, transcript_path} from worker::terminal;
import {Tail, open_tail} from worker::tail;

comptime let kPollMillis: i64 = 500;
// The registry is read every this many polls.
comptime let kStatusEvery: u32 = 4;

pub struct WatchJob : Send {
  pub var task: String
  pub var session: TerminalSession
  pub var outbox: SharedOutbox
  // Set by the crew when the task is stopped or a message for it waits.
  pub var stopped: Arc<Atomic<i32>>
}

struct Mirror {
  pub var transcript: Transcript
  pub var title: String
  // Ids of tool calls still running.
  pub var running: List<String>
}

pub fn watch_session(job: WatchJob) {
  let task = job.task.as_str();
  var m = Mirror {
    transcript: Transcript("w", job.session.id), title: String(),
    running: List::<String>()
  };
  post(job.outbox, entry_message(task, said("w.following", "note",
    "Following a Claude Code session in a terminal. Replying stops it there and continues here.")));
  post(job.outbox, state_message(task, job.session.busy ? "working" : "idle"));
  // A session that has not had its first prompt has no transcript yet.
  while (true) {
    if (let p = transcript_path(job.session.id)) {
      if (var tail = open_tail(p)) {
        follow(job, m, tail);
        break;
      }
    }
    if (job.stopped.get().load() != 0) {
      take_over(job, m);
      break;
    }
    if (!alive(job.session.pid, job.session.proc_start)) {
      post(job.outbox, state_message(task, "idle"));
      break;
    }
    sleep(milliseconds(kPollMillis));
  }
  job.outbox.get().with_arg(Ended { task: job.task.clone(), session: job.session.id.clone() },
    fn(out: &var Outbox, e: Ended) {
    out.ended.push(e);
  });
}

fn follow(job&: WatchJob, var m&: Mirror, var tail&: Tail) {
  let task = job.task.as_str();
  var busy = job.session.busy;
  var polls: u32 = 0;
  while (true) {
    drain(job, m, tail);
    if (job.stopped.get().load() != 0) {
      end_session(job.session);
      drain(job, m, tail);
      take_over(job, m);
      return;
    }
    polls += 1;
    if (polls % kStatusEvery == 0) {
      if (!alive(job.session.pid, job.session.proc_start)) {
        drain(job, m, tail);
        cut_off(job, m, "The terminal session ended.");
        post(job.outbox, state_message(task, "idle"));
        return;
      }
      if (let current = reread(job.session)) {
        // /clear or /resume moved the terminal to another session.
        if (!current.id.eq(job.session.id)) {
          drain(job, m, tail);
          cut_off(job, m, "The terminal moved on to another session.");
          post(job.outbox, state_message(task, "idle"));
          return;
        }
        if (current.busy != busy) {
          busy = current.busy;
          post(job.outbox, state_message(task, busy ? "working" : "idle"));
        }
      }
    }
    sleep(milliseconds(kPollMillis));
  }
}

// The terminal is gone for good. A turn waiting on the task sets its state
// again when it starts.
fn take_over(job&: WatchJob, var m&: Mirror) {
  end_session(job.session);
  cut_off(job, m, "Stopped with the terminal.");
  post(job.outbox, entry_message(job.task, said("w.took-over", "note", "Took over from the terminal.")));
  post(job.outbox, state_message(job.task, "stopped"));
}

// Tool calls the terminal never finished.
fn cut_off(job&: WatchJob, var m&: Mirror, why: str) {
  m.running.drain(fn(id: String) {
    post(job.outbox, entry_message(job.task, tool_finished(id, false, why)));
  });
}

fn drain(job&: WatchJob, var m&: Mirror, var tail&: Tail) {
  let task = job.task.as_str();
  while (let line = tail.next_line()) {
    let j = parse(line) else {
      continue;
    };
    if ((str_of(j, "type") ?? "") == "ai-title") {
      if (let t = str_of(j, "aiTitle")) {
        if (m.title != t) {
          m.title = from_str(t);
          post(job.outbox, title_message(task, t));
        }
      }
      continue;
    }
    var list = read_terminal(m.transcript, j);
    list.drain(fn(e: Json) {
      track(m, e);
      post(job.outbox, entry_message(task, e));
    });
  }
}

fn track(var m&: Mirror, e&: Json) {
  let id = str_of(e, "id") ?? "";
  let state = str_of(e, "state") ?? "";
  if (state == "running") {
    m.running.push(from_str(id));
  } else if (#state > 0) {
    var i: usize = 0;
    while (i < m.running.len()) {
      if (m.running[i].as_str() == id) {
        let _ = m.running.remove(i);
      } else {
        i += 1;
      }
    }
  }
}

fn title_message(task: str, title: str): Json {
  var m = object();
  set(m, "type", text("title"));
  set(m, "task", text(task));
  set(m, "title", text(title));
  return m;
}
