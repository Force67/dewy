// Host names to IPv4 addresses through the C library, since akibase's
// sockets take only numeric addresses.

module worker::resolve;

import {with_nul} from akibase::strings::base_string;
import {parse_ipv4} from akibase::net::socket_address;

extern struct AddrInfo {
  pub var flags: i32
  pub var family: i32
  pub var socktype: i32
  pub var protocol: i32
  pub var addrlen: u32
  pub var addr: *var u8
  pub var canonname: *var c8
  pub var next: *var AddrInfo
}

extern("getaddrinfo") fn c_getaddrinfo(node: *const c8, service: *const c8, hints: *const AddrInfo,
                                       res: *var *var AddrInfo): i32;
extern("freeaddrinfo") fn c_freeaddrinfo(res: *var AddrInfo): ();

comptime let kAfInet: i32 = 2;
comptime let kSockStream: i32 = 1;

pub fn resolve_ipv4(host: str): [u8; 4]? {
  if (let ip = parse_ipv4(host)) {
    return ip;
  }
  let hints = AddrInfo {
    flags: 0, family: kAfInet, socktype: kSockStream, protocol: 0, addrlen: 0, addr: null, canonname: null,
    next: null
  };
  var res: *var AddrInfo = null;
  let name = with_nul(host);
  unsafe {
    if (c_getaddrinfo(@ptr(name.as_str()), null, &raw hints, &raw var res) != 0 || res == null) {
      return none;
    }
    let info = @read(res);
    // sockaddr_in: family, port, then the address.
    let a = @slice(info.addr as *const u8, 8);
    let ip = [a[4], a[5], a[6], a[7]];
    c_freeaddrinfo(res);
    return ip;
  }
}
