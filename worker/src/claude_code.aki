// Claude Code in print mode: `claude -p <text> --output-format stream-json`
// writes one JSON event per line. A turn resumes the task's session with
// --resume.

module worker::claude_code;

import {String, from_str} from akibase::strings::base_string;
import {Vector, new} from akibase::containers::vector;
import {Command} from akibase::process::child;
import {Json, object, array, set, push, text, to_string, get, as_array, as_str, path} from akibase::text::json;
import {str_of, num_of, bool_of} from wire::fields;
import {first_line} from wire::clip;
import {said, tool_started, tool_finished} from worker::entry;
import {Transcript} from worker::transcript;
import {claude_meter} from worker::usage;
import {unix_time_milliseconds} from akibase::time::time;

// Every token a Claude usage counts, cached ones included.
fn usage_tokens(u&: Json): f64 =>
  (num_of(u, "input_tokens") ?? 0.0) + (num_of(u, "cache_creation_input_tokens") ?? 0.0)
    + (num_of(u, "cache_read_input_tokens") ?? 0.0) + (num_of(u, "output_tokens") ?? 0.0);

// With `on_stdin`, the prompt comes as a stream-json user message on
// standard input, which is how images reach Claude.
pub fn claude_command(text: str, session: str, yolo: bool, on_stdin: bool): Command {
  var c = Command("claude");
  c.arg("-p");
  if (on_stdin) {
    c.arg("--input-format");
    c.arg("stream-json");
  } else {
    c.arg(text);
  }
  c.arg("--output-format");
  c.arg("stream-json");
  c.arg("--verbose");
  if (yolo) {
    c.arg("--dangerously-skip-permissions");
  } else {
    c.arg("--permission-mode");
    c.arg("acceptEdits");
  }
  if (#session > 0) {
    c.arg("--resume");
    c.arg(session);
  }
  return c;
}

pub fn read_claude(var t&: Transcript, line&: Json): Vector<Json> {
  var out = new::<Json>();
  let kind = str_of(line, "type") ?? "";
  if (let s = str_of(line, "session_id")) {
    t.session = from_str(s);
  }
  if (kind == "assistant") {
    if (let id = str_of(get(line, "message") ?? Json::Null, "id")) {
      var seen = false;
      for (let m& in t.messages) {
        if (m.as_str() == id) {
          seen = true;
        }
      }
      if (!seen) {
        t.messages.push(from_str(id));
        t.spend(usage_tokens(path(line, "message.usage") ?? Json::Null), 0.0);
      }
    }
  }
  if (kind == "assistant" || kind == "user") {
    let blocks = as_array(path(line, "message.content") ?? Json::Null) else {
      return out;
    };
    for (let b& in blocks) {
      let block = str_of(b, "type") ?? "";
      if (block == "text") {
        let body = str_of(b, "text") ?? "";
        if (#body > 0) {
          out.push(said(t.next_id().as_str(), "agent", body));
        }
      } else if (block == "tool_use") {
        let id = t.id_for(str_of(b, "id") ?? "");
        let name = str_of(b, "name") ?? "tool";
        out.push(tool_started(id.as_str(), name, summary(get(b, "input") ?? Json::Null).as_str()));
      } else if (block == "tool_result") {
        let id = t.id_for(str_of(b, "tool_use_id") ?? "");
        let ok = !(bool_of(b, "is_error") ?? false);
        var done = tool_finished(id.as_str(), ok, result_text(get(b, "content") ?? Json::Null).as_str());
        with_images(done, images_in(get(b, "content") ?? Json::Null));
        out.push(done);
      }
    }
  } else if (kind == "rate_limit_event") {
    if (let m = claude_meter(line, unix_time_milliseconds())) {
      t.usage = to_string(m.to_json());
    }
  } else if (kind == "result") {
    let counted = t.turn_tokens;
    let total = usage_tokens(get(line, "usage") ?? Json::Null);
    t.spend(total > counted ? total - counted : 0.0, num_of(line, "total_cost_usd") ?? 0.0);
    if (bool_of(line, "is_error") ?? false) {
      t.failed = true;
      let why = str_of(line, "result") ?? "Claude stopped with an error.";
      out.push(said(t.next_id().as_str(), "error", why));
    }
    if (let denials = as_array(get(line, "permission_denials") ?? Json::Null)) {
      for (let d& in denials) {
        var note = from_str("Claude was not allowed to use ");
        note.push_str(str_of(d, "tool_name") ?? "a tool");
        let what = summary(get(d, "tool_input") ?? Json::Null);
        if (what.len() > 0) {
          note.push_str(": ");
          note.push_str(what.as_str());
        }
        out.push(said(t.next_id().as_str(), "note", note.as_str()));
      }
    }
  }
  return out;
}

// A line of the transcript Claude Code writes for a session it runs in a
// terminal. Its messages carry the same blocks as stream-json. What the
// person typed has origin "human"; injected context (isMeta) and subagent
// traffic (isSidechain) stay out. Ids come from the transcript, so reading
// a line twice updates the same entries.
pub fn read_terminal(var t&: Transcript, line&: Json): Vector<Json> {
  var out = new::<Json>();
  if ((bool_of(line, "isSidechain") ?? false) || (bool_of(line, "isMeta") ?? false)) {
    return out;
  }
  let kind = str_of(line, "type") ?? "";
  let uuid = str_of(line, "uuid") ?? "";
  var human = false;
  if (let origin = path(line, "origin.kind")) {
    human = (as_str(origin) ?? "") == "human";
  }
  // A message typed while the session was busy.
  if (kind == "attachment" && (str_of(path(line, "attachment") ?? Json::Null, "type") ?? "") == "queued_command") {
    if (let a = path(line, "attachment")) {
      let prompt = result_text(get(a, "prompt") ?? Json::Null);
      let pasted = images_in(get(a, "prompt") ?? Json::Null);
      let has_images = #as_array(pasted)! > 0;
      if ((as_str(path(a, "origin.kind") ?? Json::Null) ?? "") == "human" && (prompt.len() > 0 || has_images)) {
        var e = said(t.id_for(uuid).as_str(), "user", prompt.as_str());
        with_images(e, pasted);
        out.push(e);
      }
    }
    return out;
  }
  if (kind == "user" && human) {
    if (let content = path(line, "message.content")) {
      if (let s = as_str(content)) {
        out.push(said(t.id_for(uuid).as_str(), "user", s));
        return out;
      }
    }
  }
  let blocks = as_array(path(line, "message.content") ?? Json::Null) else {
    return out;
  };
  var i: u64 = 0;
  for (let b& in blocks) {
    let block = str_of(b, "type") ?? "";
    var local = from_str(uuid);
    local.push_c8('.');
    local.push_u64(i);
    i += 1;
    if (block == "text") {
      let body = str_of(b, "text") ?? "";
      if (kind == "assistant" && #body > 0) {
        out.push(said(t.id_for(local.as_str()).as_str(), "agent", body));
      } else if (kind == "user" && human && #body > 0) {
        out.push(said(t.id_for(local.as_str()).as_str(), "user", body));
      }
    } else if (block == "tool_use" && kind == "assistant") {
      let id = t.id_for(str_of(b, "id") ?? "");
      let name = str_of(b, "name") ?? "tool";
      out.push(tool_started(id.as_str(), name, summary(get(b, "input") ?? Json::Null).as_str()));
    } else if (block == "tool_result" && kind == "user") {
      let id = t.id_for(str_of(b, "tool_use_id") ?? "");
      let ok = !(bool_of(b, "is_error") ?? false);
      var done = tool_finished(id.as_str(), ok, result_text(get(b, "content") ?? Json::Null).as_str());
      with_images(done, images_in(get(b, "content") ?? Json::Null));
      out.push(done);
    }
  }
  // Images pasted into a prompt come as their own entry, before its text.
  if (kind == "user" && human) {
    let pasted = images_in(path(line, "message.content") ?? Json::Null);
    if (#as_array(pasted)! > 0) {
      var e = said(t.id_for(uuid).as_str(), "user", "");
      with_images(e, pasted);
      out.insert(0, e);
    }
  }
  return out;
}

// Images whose base64 would take an entry past this stay out, so it keeps
// under the line limit.
comptime let kMaxImageText: usize = 6 << 20;

// The image blocks among content, as {type, data} for the orchestrator to
// store.
fn images_in(content&: Json): Json {
  var out = array();
  var total: usize = 0;
  if (let blocks = as_array(content)) {
    for (let b& in blocks) {
      if ((str_of(b, "type") ?? "") != "image") {
        continue;
      }
      if (let src = get(b, "source")) {
        let data = str_of(src, "data") ?? "";
        // The cap holds for the entry, whose images travel in one line.
        if ((str_of(src, "type") ?? "") == "base64" && #data > 0 && total + #data <= kMaxImageText) {
          total += #data;
          var o = object();
          set(o, "type", text(str_of(src, "media_type") ?? "image/png"));
          set(o, "data", text(data));
          push(out, o);
        }
      }
    }
  }
  return out;
}

fn with_images(var e&: Json, images: Json): () {
  if (let list = as_array(images)) {
    if (#list > 0) {
      set(e, "images", images);
    }
  }
}

// The stream-json user message that gives Claude a prompt and images.
pub fn claude_input(prompt: str, images&: [(str, str)]): String {
  var content = array();
  for (let img& in images) {
    var src = object();
    set(src, "type", text("base64"));
    set(src, "media_type", text(img.0));
    set(src, "data", text(img.1));
    var block = object();
    set(block, "type", text("image"));
    set(block, "source", src);
    push(content, block);
  }
  if (#prompt > 0) {
    var block = object();
    set(block, "type", text("text"));
    set(block, "text", text(prompt));
    push(content, block);
  }
  var message = object();
  set(message, "role", text("user"));
  set(message, "content", content);
  var line = object();
  set(line, "type", text("user"));
  set(line, "message", message);
  var out = to_string(line);
  out.push_c8('\n');
  return out;
}

// The one input field that says what a tool call does.
fn summary(input&: Json): String {
  let keys = ["command", "file_path", "pattern", "url", "query", "description", "prompt", "path"];
  for (let k in keys) {
    if (let v = str_of(input, k)) {
      return from_str(first_line(v, 300));
    }
  }
  return String();
}

// A tool result is text, or a list of blocks of which the text ones count.
fn result_text(content&: Json): String {
  if (let s = as_str(content)) {
    return from_str(s);
  }
  var out = String();
  if (let blocks = as_array(content)) {
    for (let b& in blocks) {
      if (let s = str_of(b, "text")) {
        out.push_str(s);
      }
    }
  }
  return out;
}
