// Claude Code in print mode: `claude -p <text> --output-format stream-json`
// writes one JSON event per line. A turn resumes the task's session with
// --resume.

module worker::claude_code;

import {String, from_str} from akibase::strings::base_string;
import {Vector, new} from akibase::containers::vector;
import {Command} from akibase::process::child;
import {Json, get, as_array, as_str, path} from akibase::text::json;
import {str_of, bool_of} from wire::fields;
import {first_line} from wire::clip;
import {said, tool_started, tool_finished} from worker::entry;
import {Transcript} from worker::transcript;

pub fn claude_command(text: str, session: str, yolo: bool): Command {
  var c = Command("claude");
  c.arg("-p");
  c.arg(text);
  c.arg("--output-format");
  c.arg("stream-json");
  c.arg("--verbose");
  if (yolo) {
    c.arg("--dangerously-skip-permissions");
  } else {
    c.arg("--permission-mode");
    c.arg("acceptEdits");
  }
  if (#session > 0) {
    c.arg("--resume");
    c.arg(session);
  }
  return c;
}

pub fn read_claude(var t&: Transcript, line&: Json): Vector<Json> {
  var out = new::<Json>();
  let kind = str_of(line, "type") ?? "";
  if (let s = str_of(line, "session_id")) {
    t.session = from_str(s);
  }
  if (kind == "assistant" || kind == "user") {
    let blocks = as_array(path(line, "message.content") ?? Json::Null) else {
      return out;
    };
    for (let b& in blocks) {
      let block = str_of(b, "type") ?? "";
      if (block == "text") {
        let body = str_of(b, "text") ?? "";
        if (#body > 0) {
          out.push(said(t.next_id().as_str(), "agent", body));
        }
      } else if (block == "tool_use") {
        let id = t.id_for(str_of(b, "id") ?? "");
        let name = str_of(b, "name") ?? "tool";
        out.push(tool_started(id.as_str(), name, summary(get(b, "input") ?? Json::Null).as_str()));
      } else if (block == "tool_result") {
        let id = t.id_for(str_of(b, "tool_use_id") ?? "");
        let ok = !(bool_of(b, "is_error") ?? false);
        out.push(tool_finished(id.as_str(), ok, result_text(get(b, "content") ?? Json::Null).as_str()));
      }
    }
  } else if (kind == "result") {
    if (bool_of(line, "is_error") ?? false) {
      t.failed = true;
      let why = str_of(line, "result") ?? "Claude stopped with an error.";
      out.push(said(t.next_id().as_str(), "error", why));
    }
    if (let denials = as_array(get(line, "permission_denials") ?? Json::Null)) {
      for (let d& in denials) {
        var note = from_str("Claude was not allowed to use ");
        note.push_str(str_of(d, "tool_name") ?? "a tool");
        let what = summary(get(d, "tool_input") ?? Json::Null);
        if (what.len() > 0) {
          note.push_str(": ");
          note.push_str(what.as_str());
        }
        out.push(said(t.next_id().as_str(), "note", note.as_str()));
      }
    }
  }
  return out;
}

// A line of the transcript Claude Code writes for a session it runs in a
// terminal. Its messages carry the same blocks as stream-json. What the
// person typed has origin "human"; injected context (isMeta) and subagent
// traffic (isSidechain) stay out. Ids come from the transcript, so reading
// a line twice updates the same entries.
pub fn read_terminal(var t&: Transcript, line&: Json): Vector<Json> {
  var out = new::<Json>();
  if ((bool_of(line, "isSidechain") ?? false) || (bool_of(line, "isMeta") ?? false)) {
    return out;
  }
  let kind = str_of(line, "type") ?? "";
  let uuid = str_of(line, "uuid") ?? "";
  var human = false;
  if (let origin = path(line, "origin.kind")) {
    human = (as_str(origin) ?? "") == "human";
  }
  // A message typed while the session was busy.
  if (kind == "attachment" && (str_of(path(line, "attachment") ?? Json::Null, "type") ?? "") == "queued_command") {
    if (let a = path(line, "attachment")) {
      let prompt = result_text(get(a, "prompt") ?? Json::Null);
      if ((as_str(path(a, "origin.kind") ?? Json::Null) ?? "") == "human" && prompt.len() > 0) {
        out.push(said(t.id_for(uuid).as_str(), "user", prompt.as_str()));
      }
    }
    return out;
  }
  if (kind == "user" && human) {
    if (let content = path(line, "message.content")) {
      if (let s = as_str(content)) {
        out.push(said(t.id_for(uuid).as_str(), "user", s));
        return out;
      }
    }
  }
  let blocks = as_array(path(line, "message.content") ?? Json::Null) else {
    return out;
  };
  var i: u64 = 0;
  for (let b& in blocks) {
    let block = str_of(b, "type") ?? "";
    var local = from_str(uuid);
    local.push_c8('.');
    local.push_u64(i);
    i += 1;
    if (block == "text") {
      let body = str_of(b, "text") ?? "";
      if (kind == "assistant" && #body > 0) {
        out.push(said(t.id_for(local.as_str()).as_str(), "agent", body));
      } else if (kind == "user" && human && #body > 0) {
        out.push(said(t.id_for(local.as_str()).as_str(), "user", body));
      }
    } else if (block == "tool_use" && kind == "assistant") {
      let id = t.id_for(str_of(b, "id") ?? "");
      let name = str_of(b, "name") ?? "tool";
      out.push(tool_started(id.as_str(), name, summary(get(b, "input") ?? Json::Null).as_str()));
    } else if (block == "tool_result" && kind == "user") {
      let id = t.id_for(str_of(b, "tool_use_id") ?? "");
      let ok = !(bool_of(b, "is_error") ?? false);
      out.push(tool_finished(id.as_str(), ok, result_text(get(b, "content") ?? Json::Null).as_str()));
    }
  }
  return out;
}

// The one input field that says what a tool call does.
fn summary(input&: Json): String {
  let keys = ["command", "file_path", "pattern", "url", "query", "description", "prompt", "path"];
  for (let k in keys) {
    if (let v = str_of(input, k)) {
      return from_str(first_line(v, 300));
    }
  }
  return String();
}

// A tool result is text, or a list of blocks of which the text ones count.
fn result_text(content&: Json): String {
  if (let s = as_str(content)) {
    return from_str(s);
  }
  var out = String();
  if (let blocks = as_array(content)) {
    for (let b& in blocks) {
      if (let s = str_of(b, "text")) {
        out.push_str(s);
      }
    }
  }
  return out;
}
