// opencode: `opencode run --format json <text>` writes one JSON event per
// line, `-s <session>` continues a session, and `-m provider/model` picks
// the model. A tool shows only once it ended, in a single event.

module worker::opencode;

import {Invocation, args} from worker::invocation;

import {String, from_str} from akikit::strings::string;
import {List} from akikit::containers::list;
import {Command} from akikit::process::child;
import {Json, array, push, text, get, path} from akikit::text::json;
import {lines} from akikit::strings::string_util;
import {trim} from akikit::strings::string_search;
import {seconds} from akikit::time::time;
import {output_of} from worker::command;
import {str_of, num_of} from wire::fields;
import {said, tool_started, tool_finished} from worker::entry;
import {Transcript} from worker::transcript;

pub fn opencode_command(text: str, session: str, model: str, yolo: bool, images&: [String]): Invocation {
  var c = Invocation("opencode");
  args(c, "run", "--format", "json");
  if (#session > 0) {
    args(c, "-s", session);
  }
  if (#model > 0) {
    args(c, "-m", model);
  }
  if (yolo) {
    c.arg("--auto");
  }
  for (let p& in images) {
    args(c, "-f", p);
  }
  // -f takes several files, and a prompt may start with a dash.
  args(c, "--", #text > 0 ? text : "See the attached images.");
  return c;
}

// The models `opencode models` lists, empty when it fails or hangs.
pub fn opencode_models(): Json {
  var models = array();
  var command = Command("opencode");
  command.arg("models");
  let output = output_of(command, seconds(20)) else { return models; };
  for (let line in lines(output)) {
    let model = trim(line);
    if (#model > 0) { push(models, text(model)); }
  }
  return models;
}

pub fn read_opencode(var t&: Transcript, line&: Json): List<Json> {
  var out = List::<Json>();
  if (let s = str_of(line, "sessionID")) {
    t.session = from_str(s);
  }
  let kind = str_of(line, "type") ?? "";
  if (kind == "text") {
    let part = get(line, "part") else {
      return out;
    };
    let body = str_of(part, "text") ?? "";
    if (#trim(body) > 0) {
      out.push(said(t.id_for(str_of(part, "id") ?? "").as_str(), "agent", body));
    }
  } else if (kind == "tool_use") {
    let part = get(line, "part") else {
      return out;
    };
    let id = t.id_for(str_of(part, "id") ?? "");
    out.push(tool_started(id, str_of(part, "tool") ?? "tool", tool_detail(part)));
    let state = get(part, "state") else {
      return out;
    };
    if ((str_of(state, "status") ?? "") == "error") {
      out.push(tool_finished(id, false, str_of(state, "error") ?? ""));
    } else {
      var ok = true;
      if (let m = get(state, "metadata")) {
        ok = (num_of(m, "exit") ?? 0.0) == 0.0;
      }
      out.push(tool_finished(id, ok, str_of(state, "output") ?? ""));
    }
  } else if (kind == "step_finish") {
    if (let part = get(line, "part")) {
      t.spend(num_of(path(part, "tokens") ?? Json::Null, "total") ?? 0.0, num_of(part, "cost") ?? 0.0);
    }
  } else if (kind == "error") {
    t.failed = true;
    var why = "opencode failed.";
    if (let e = get(line, "error")) {
      why = str_of(e, "name") ?? why;
      if (let data = get(e, "data")) {
        why = str_of(data, "message") ?? why;
      }
    }
    out.push(said(t.next_id().as_str(), "error", why));
  }
  return out;
}

fn tool_detail<'a>(part: &'a Json): str<'a> {
  if (let input = path(part, "state.input")) {
    if (let command = str_of(input, "command")) {
      return command;
    }
    if (let file = str_of(input, "filePath")) {
      return file;
    }
  }
  if (let state = get(part, "state")) {
    return str_of(state, "title") ?? "";
  }
  return "";
}
