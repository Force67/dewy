// Short commands with a deadline and automatically cleaned-up output.
module worker::command;

import {String} from akikit::strings::string;
import {Command, exit_code} from akikit::process::child;
import {create_temp_dir} from akikit::filesystem::scoped_temp_dir;
import {read_file} from akikit::filesystem::file_util;
import {Duration, seconds} from akikit::time::time;

// akikit's capture::output waits indefinitely. Keep a deadline for CLI
// probes, but let ScopedTempDir handle every cleanup path.
pub fn output_of(var command&: Command, timeout: Duration = seconds(30)): String? {
  let dir = create_temp_dir("dewy-command") else { return none; };
  let output = f"{dir.path()}/stdout";
  command.stdin_from("/dev/null");
  command.stdout_to(output);
  command.stderr_to("/dev/null");
  var child = command.spawn() else { return none; };
  let status = child.wait_timeout(timeout) else {
    let _ = child.kill();
    let _ = child.wait();
    return none;
  };
  if (exit_code(status) != 0) { return none; }
  let result = read_file(output) else { return none; };
  return result;
}
