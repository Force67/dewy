// What a box tells the orchestrator about itself: its name and system,
// the agents on its PATH and the models opencode offers, the git
// repositories below its project roots, and load and memory from /proc.

module worker::inventory;

import {String, from_str} from akikit::strings::string;
import {List} from akikit::containers::list;
import {Json, object, array, set, push, text, number, boolean} from akikit::text::json;
import {get_environment_variable} from akikit::process::environment_variables;
import {read_file, path_exists} from akikit::filesystem::file_util;
import {is_directory, list_directory} from akikit::filesystem::directory;
import {join, file_name} from akikit::filesystem::path;
import {split, split_whitespace, lines} from akikit::strings::string_util;
import {trim, strip_prefix, trim_matches} from akikit::strings::string_search;
import {parse_f64} from akikit::strings::string_to_number;
import {sort} from akikit::algorithm;
import {opencode_models} from worker::opencode;
import {Command} from akikit::process::child;
import {output_of} from worker::command;
import {contains} from akikit::strings::string_search;

pub fn hostname(): String {
  let name = read_file("/proc/sys/kernel/hostname") ?? from_str("box");
  return from_str(trim(name));
}

fn os_name(): String {
  let release = read_file("/etc/os-release") ?? String();
  for (let line in lines(release)) {
    if (let v = strip_prefix(line, "PRETTY_NAME=")) {
      return from_str(trim_matches(v, "\""));
    }
  }
  return from_str("Linux");
}

pub fn on_path(program: str): bool {
  let path = get_environment_variable("PATH") ?? String();
  for (let dir in split(path, ":")) {
    if (#dir > 0 && path_exists(join(dir, program).as_str())) {
      return true;
    }
  }
  return false;
}

fn repositories(roots&: [String]): Json {
  var paths = List::<String>();
  for (let root& in roots) {
    if (is_directory(join(root, ".git").as_str())) {
      paths.push(root.clone());
      continue;
    }
    for (let name& in list_directory(root) ?? List::<String>()) {
      let dir = join(root, name);
      if (is_directory(join(dir, ".git").as_str())) {
        paths.push(dir);
      }
    }
  }
  sort(paths.as_slice_var());
  var out = array();
  for (let p& in paths) {
    var o = object();
    set(o, "name", text(file_name(p)));
    set(o, "path", text(p));
    push(out, o);
  }
  return out;
}

// The models each agent offers. Listed before dialing, as the orchestrator
// waits only ten seconds for the hello.
pub fn models(): Json {
  var out = object();
  if (on_path("opencode")) {
    set(out, "opencode", opencode_models());
  }
  return out;
}

pub fn hello(token: str, name: str, roots&: [String], models: Json, running: Json): Json {
  var agents = array();
  for (let a in ["claude", "codex", "opencode"]) {
    if (on_path(a)) {
      push(agents, text(a));
    }
  }
  var h = object();
  set(h, "type", text("hello"));
  set(h, "token", text(token));
  set(h, "box", text(name));
  set(h, "host", text(hostname().as_str()));
  set(h, "os", text(os_name().as_str()));
  set(h, "agents", agents);
  set(h, "models", models);
  set(h, "poweroff", boolean(can_power_off()));
  set(h, "projects", repositories(roots));
  set(h, "running", running);
  return h;
}

// Whether logind lets this user turn the machine off without asking for a
// password, as it does for an active local session.
fn can_power_off(): bool {
  var c = Command("busctl");
  for (let a in ["call", "org.freedesktop.login1", "/org/freedesktop/login1", "org.freedesktop.login1.Manager", "CanPowerOff"]) {
    c.arg(a);
  }
  let answer = output_of(c) else {
    return false;
  };
  return contains(answer, "\"yes\"");
}

fn meminfo_kb(info: str, key: str): f64 {
  for (let line in lines(info)) {
    if (let rest = strip_prefix(line, key)) {
      let words = split_whitespace(rest);
      if (words.len() > 0) {
        return parse_f64(words[0]) ?? 0.0;
      }
    }
  }
  return 0.0;
}

pub fn stats(): Json {
  var s = object();
  let load = read_file("/proc/loadavg") ?? String();
  let words = split_whitespace(load);
  set(s, "load", number(words.len() > 0 ? parse_f64(words[0]) ?? 0.0 : 0.0));
  let cpu = read_file("/proc/cpuinfo") ?? String();
  var cpus: u32 = 0;
  for (let line in lines(cpu)) {
    if (strip_prefix(line, "processor") != none) {
      cpus += 1;
    }
  }
  set(s, "cpus", number(cpus as f64));
  let mem = read_file("/proc/meminfo") ?? String();
  let total = meminfo_kb(mem, "MemTotal:");
  let available = meminfo_kb(mem, "MemAvailable:");
  set(s, "memTotal", number(total * 1024.0));
  set(s, "memUsed", number((total - available) * 1024.0));
  let up = read_file("/proc/uptime") ?? String();
  let up_words = split_whitespace(up);
  set(s, "uptime", number(up_words.len() > 0 ? parse_f64(up_words[0]) ?? 0.0 : 0.0));
  var m = object();
  set(m, "type", text("stats"));
  set(m, "stats", s);
  return m;
}
