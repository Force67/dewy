// One turn of one agent: tmux owns the supervisor and the agent; this
// thread follows its durable JSON output and can recover it after restart.

module worker::turn;

import {String, from_str, with_nul} from akikit::strings::string;
import {List} from akikit::containers::list;
import {Json, parse, object, array, push, set, text, number, to_string} from akikit::text::json;
import {Arc} from akikit::memory::arc;
import {Mutex} from akikit::threading::mutex;
import {Atomic} from akikit::threading::atomic;
import {read_file, write_file, path_exists} from akikit::filesystem::file_util;
import {decode} from wire::base64;
import {write_bytes} from akikit::filesystem::file_util;
import {temp_directory} from akikit::filesystem::common_directory_providers;
import {join} from akikit::filesystem::path;
import {milliseconds, seconds, sleep, now} from akikit::time::time;
import {create_directories} from akikit::filesystem::directory;
import {parse_f64} from akikit::strings::string_to_number;
import {trim, find} from akikit::strings::string_search;
import {clip} from wire::clip;
import {said, entry_message} from worker::entry;
import {usage_message} from worker::usage;
import {Transcript} from worker::transcript;
import {run_dir, stop_path} from worker::store;
import {atomic_write} from wire::files;
import {socket_path, session_name, launch, exists, result, close_session, abandon} from worker::tmux;
import {claude_command, claude_input, read_claude} from worker::claude_code;
import {codex_command, read_codex, read_rollout, rollout_of, last_total, rollout_total} from worker::codex;
import {Tail, open_tail} from worker::tail;
import {opencode_command, read_opencode} from worker::opencode;
import {find_session, end_session} from worker::terminal;

pub enum Agent {
  Claude, Codex, OpenCode

  pub fn name(self): str<'static> => match (self) {
    Agent::Claude => "claude",
    Agent::Codex => "codex",
    Agent::OpenCode => "opencode",
  };
}

pub fn agent_named(name: str): Agent? => match (name) {
  "claude" => Agent::Claude,
  "codex" => Agent::Codex,
  "opencode" => Agent::OpenCode,
  _ => none,
};

// A turn that ended, so the crew can start the next one for its task.
pub struct Ended : Send {
  pub var task: String
  pub var session: String
  pub var record: String = String()
}

pub struct Outbox : Send {
  // JSON lines for the orchestrator.
  pub var lines: List<String> = List()
  pub var ended: List<Ended> = List()
  // The newest measured usage line not yet sent; a newer one replaces it,
  // so a worker cut off for days does not pile them up.
  pub var measured: String = String()
}

pub type SharedOutbox = Arc<Mutex<Outbox>>;

// An image for the turn's prompt, its data in base64.
pub struct TurnImage : Send {
  pub var id: String
  pub var media: String
  pub var data: String
}

pub struct TurnOrder : Send {
  pub var record: String
  pub var task: String
  pub var turn: String
  pub var agent: Agent
  pub var project: String
  pub var session: String
  pub var text: String
  // The task asked to run without permission prompts.
  pub var yolo: bool
  pub var images: List<TurnImage>
  // provider/model for opencode, empty for the agent's default.
  pub var model: String
}

pub struct TurnJob : Send {
  pub var order: TurnOrder
  pub var yolo: bool
  pub var outbox: SharedOutbox
  pub var data_dir: String
  // Set by the crew when the user stopped the task.
  pub var stopped: Arc<Atomic<i32>>
}

pub fn post(outbox&: SharedOutbox, j&: Json) {
  outbox.get().with_arg(to_string(j), fn(o: &var Outbox, line: String) {
    o.lines.push(line);
  });
}

pub fn state_message(task: str, state: str): Json {
  var m = object();
  set(m, "type", text("state"));
  set(m, "task", text(task));
  set(m, "state", text(state));
  return m;
}

fn session_message(task: str, session: str): Json {
  var m = object();
  set(m, "type", text("session"));
  set(m, "task", text(task));
  set(m, "session", text(session));
  return m;
}

pub fn run_turn(job: TurnJob) {
  let o& = job.order;
  let task = o.task.as_str();
  let dir = run_dir(o.record);
  let out_path = join(dir, "output.jsonl");
  let err_path = join(dir, "stderr");
  let replay = path_exists(join(dir, "launch.json").as_str());
  let session = replay ? (read_file(join(dir, "session").as_str()) ?? o.session.clone()) : o.session.clone();
  var t = Transcript(o.turn, session);
  if (path_exists(stop_path(o.record).as_str())) { job.stopped.get().store(1); }
  if (job.stopped.get().load() == 0) { post(job.outbox, state_message(task, "working")); }
  var ok = false;
  if (create_directories(dir)) {
    var baseline: f64 = 0.0;
    if (!replay) {
      if (o.agent == Agent::Codex && !o.session.is_empty()) {
        if (let path = rollout_of(o.session)) { baseline = last_total(path); }
      }
      let _ = atomic_write(join(dir, "session").as_str(), o.session);
      let _ = atomic_write(join(dir, "baseline").as_str(), f"{baseline}".as_str());
    }
    t.codex_total = parse_f64((read_file(join(dir, "baseline").as_str()) ?? from_str("0")).as_str()) ?? 0.0;
    // A replay uses the exact input and argv saved before the first launch.
    if (replay) {
      ok = run_agent(job, dir, out_path, err_path, [], t);
    } else if (job.stopped.get().load() == 0) {
      if (let images = image_files(o, join(dir, "input").as_str())) {
        // The existing terminal integration still hands over before tmux
        // starts a headless turn; two agents never write one session.
        if (o.agent == Agent::Claude && !o.session.is_empty()) {
          if (let session = find_session(o.session)) {
            end_session(session);
            post(job.outbox, entry_message(task, said(t.id_for("takeover").as_str(), "note", "Took over from the terminal.")));
          }
        }
        ok = run_agent(job, dir, out_path, err_path, images.as_slice(), t);
      } else {
        post(job.outbox, entry_message(task, said(t.id_for("images").as_str(), "error", "The worker could not prepare the images for this message.")));
      }
    }
  } else {
    post(job.outbox, entry_message(task, said(t.id_for("storage").as_str(), "error", "The worker could not create the turn directory.")));
  }
  if (t.failed) { ok = false; }
  post(job.outbox, state_message(task, job.stopped.get().load() != 0 ? "stopped" : (ok ? "idle" : "failed")));
  job.outbox.get().with_arg(Ended { task: o.task.clone(), session: t.session.clone(), record: o.record.clone() },
    fn(out: &var Outbox, e: Ended) { out.ended.push(e); });
}

fn extension(media: str): str<'static> => match (media) {
  "image/jpeg" => ".jpg",
  "image/webp" => ".webp",
  "image/gif" => ".gif",
  _ => ".png",
};

// Writes the turn's images where its agent takes them: Claude reads a
// stream-json message on standard input, which becomes the first of the
// returned paths; Codex and opencode get files. Files live in the turn directory until its final messages are sent.
// None when an image could not be written, rather than a turn without it.
fn image_files(o&: TurnOrder, stem: str): List<String>? {
  var paths = List::<String>();
  if (o.images.is_empty()) {
    return paths;
  }
  if (o.agent == Agent::Claude) {
    var pairs = List::<(str, str)>();
    for (let img& in o.images) {
      pairs.push((img.media, img.data));
    }
    var p = from_str(stem);
    p.push_str(".in");
    if (let _ = write_file(p, claude_input(o.text, pairs.as_slice()).as_str())) {
      paths.push(p);
      return paths;
    }
    return none;
  }
  var n: u64 = 0;
  for (let img& in o.images) {
    let data = decode(img.data) else {
      return none;
    };
    var p = from_str(stem);
    p.push_str(".img");
    p.push_u64(n);
    p.push_str(extension(img.media));
    n += 1;
    if (let _ = write_bytes(p, data.as_slice())) {} else { return none; }
    paths.push(p);
  }
  return paths;
}

extern("mkdir") fn c_mkdir(path: *const c8, mode: u32): i32;
extern("chmod") fn c_chmod(path: *const c8, mode: u32): i32;
extern("getuid") fn c_getuid(): u32;

// A directory only this user can read, for a turn's output and the images
// it hands the agent, which may be private screenshots.
pub fn private_temp(): String {
  var name = from_str("dewy-worker-");
  var uid: u32 = 0;
  unsafe {
    uid = c_getuid();
  }
  name.push_u64(uid as u64);
  let dir = join(temp_directory().as_str(), name);
  let c = with_nul(dir);
  unsafe {
    let _ = c_mkdir(@ptr(c.as_str()), 0o700);
    let _ = c_chmod(@ptr(c.as_str()), 0o700);
  }
  return dir;
}

// Runs the agent to the end; false when it could not start or exited
// with an error.
fn run_agent(job&: TurnJob, dir: str, out_path: str, err_path: str, images&: [String], var t&: Transcript): bool {
  let o& = job.order;
  let task = o.task.as_str();
  let socket = socket_path(job.data_dir);
  let name = session_name(task, o.turn);
  if (!path_exists(join(dir, "launch.json").as_str())) {
    let on_stdin = o.agent == Agent::Claude && #images > 0;
    let cmd = match (o.agent) {
      Agent::Claude => claude_command(o.text, o.session, job.yolo, on_stdin),
      Agent::Codex => codex_command(o.text, o.session, job.yolo, images),
      Agent::OpenCode => opencode_command(o.text, o.session, o.model, job.yolo, images),
    };
    let _ = write_file(out_path, "");
    if (job.stopped.get().load() != 0) { return false; }
    if (!launch(socket, name, dir, o.project, on_stdin ? images[0].as_str() : "/dev/null",
                stop_path(o.record).as_str(), cmd)) {
      post(job.outbox, entry_message(task, said(t.id_for("launch").as_str(), "error", "Could not start the agent in tmux.")));
      return false;
    }
  }
  var tail = open_tail(out_path) else {
    post(job.outbox, entry_message(task, said(t.id_for("output").as_str(), "error", "Could not read the agent's output file.")));
    return false;
  };
  var session = o.session.clone();
  let provider = provider_of(o);
  var rollout: Tail? = none;
  var lookups: u32 = 0;
  var finished = false;
  var probe = now();
  while (true) {
    if (job.stopped.get().load() != 0) {
      let _ = atomic_write(stop_path(o.record).as_str(), "stopped");
    }
    var next = tail.next_line();
    if (next == none && finished) { next = tail.final_line(); }
    let line = next else {
      follow(rollout, t, job, provider);
      if (finished) { break; }
      if (result(dir) != none) { finished = true; continue; }
      if (probe.elapsed() > seconds(1)) {
        probe = now();
        if (!exists(socket, name) && result(dir) == none) {
          abandon(dir);
          finished = true;
          continue;
        }
      }
      sleep(milliseconds(100));
      continue;
    };
    let j = parse(line) else {
      continue;
    };
    var entries = match (o.agent) {
      Agent::Claude => read_claude(t, j),
      Agent::Codex => read_codex(t, j),
      Agent::OpenCode => read_opencode(t, j),
    };
    if (!t.usage.is_empty()) {
      var meters = array();
      push(meters, parse(t.usage)!);
      post(job.outbox, usage_message(meters));
      t.usage = String();
    }
    if (!t.session.eq(session)) {
      session = t.session.clone();
      post(job.outbox, session_message(task, session));
    }
    entries.drain(fn(e: Json) { post(job.outbox, entry_message(task, e)); });
    if (o.agent == Agent::Codex) {
      // The rollout exists once Codex names the session; an old session
      // outside the newest days is not worth a search per line.
      if (rollout == none && !session.is_empty() && lookups < 5) {
        lookups += 1;
        if (let path = rollout_of(session)) {
          if (let opened = open_tail(path)) {
            let r = opened;
            rollout = r;
            t.rollout = true;
          }
        }
      }
      follow(rollout, t, job, provider);
    }
    post_spend(job, t, provider);
  }
  follow(rollout, t, job, provider);
  post_spend(job, t, provider);
  close_session(socket, name);
  if ((result(dir) ?? 125) == 0) {
    return true;
  }
  if (!t.failed && job.stopped.get().load() == 0) {
    let err = read_file(err_path) ?? String();
    var why = from_str(o.agent.name());
    why.push_str(" exited with an error.");
    let tail = trim(err);
    if (#tail > 0) {
      why.push_str("\n\n");
      why.push_str(clip(tail, 1500));
    }
    post(job.outbox, entry_message(task, said(t.id_for("exit").as_str(), "error", why)));
  }
  return false;
}

// Who the turn's tokens count against: opencode's is its model's provider,
// unknown for the default model.
fn provider_of(o&: TurnOrder): String => match (o.agent) {
  Agent::Claude => from_str("anthropic"),
  Agent::Codex => from_str("openai"),
  Agent::OpenCode => from_str(o.model.as_str()[..(find(o.model, "/") ?? 0)]),
};

// Reads what Codex's rollout gained: its calls' tokens, then the limits
// after them, so the orchestrator has the tokens when the limits rise.
fn follow(var rollout&: Tail?, var t&: Transcript, job&: TurnJob, provider: str) {
  if (var r& = rollout) {
    while (let line = r.next_line()) {
      if (let j = parse(line)) {
        if (let end = read_file(join(run_dir(job.order.record).as_str(), "rollout-end").as_str())) {
          if (let limit = parse_f64(end)) {
            if ((rollout_total(j) ?? 0.0) > limit) { continue; }
          }
        }
        if (let m = read_rollout(t, j)) {
          post_spend(job, t, provider);
          var meters = array();
          push(meters, m.to_json());
          post(job.outbox, usage_message(meters));
        }
      }
    }
  }
}

fn post_spend(job&: TurnJob, var t&: Transcript, provider: str) {
  if (t.tokens <= 0.0 && t.cost <= 0.0) {
    return;
  }
  var m = object();
  set(m, "type", text("spend"));
  set(m, "task", text(job.order.task));
  set(m, "provider", text(provider));
  set(m, "turn", text(job.order.turn));
  set(m, "tokens", number(t.turn_tokens));
  set(m, "cost", number(t.turn_cost));
  post(job.outbox, m);
  t.tokens = 0.0;
  t.cost = 0.0;
}
