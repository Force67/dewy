// Real output of `claude -p ... --output-format stream-json`,
// `codex exec --json`, and `opencode run --format json`, trimmed, through
// the translators.

module transcript_test;

import {String} from akikit::strings::string;
import {List} from akikit::containers::list;
import {Json, parse, to_string} from akikit::text::json;
import {lines} from akikit::strings::string_util;
import {eprintln} from akikit::logging;
import {Transcript} from worker::transcript;
import {read_claude, read_terminal, claude_input} from worker::claude_code;
import {read_codex, read_rollout} from worker::codex;
import {read_opencode} from worker::opencode;

comptime let kClaude: str = r"""
{"type":"system","subtype":"init","session_id":"2896"}
{"type":"assistant","message":{"content":[{"type":"thinking","thinking":"","signature":"x"}]},"session_id":"2896"}
{"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_01","name":"Bash","input":{"command":"ls","description":"List files"}}]},"session_id":"2896"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01","type":"tool_result","content":"a.txt","is_error":false}]},"session_id":"2896"}
{"type":"assistant","message":{"content":[{"type":"text","text":"File."}]},"session_id":"2896"}
{"type":"result","subtype":"success","is_error":false,"result":"File.","session_id":"2896","permission_denials":[{"tool_name":"Bash","tool_input":{"command":"rm -rf build"}}]}
""";

comptime let kCodex: str = r"""
{"type":"thread.started","thread_id":"01a0"}
{"type":"turn.started"}
{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"Running `ls`.\n"}}
{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc ls","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc ls","aggregated_output":"a.txt\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"agent_message","text":"Done"}}
{"type":"turn.completed","usage":{"input_tokens":33352}}
""";

comptime let kOpenCode: str = r"""
{"type":"step_start","timestamp":1790777185236,"sessionID":"ses_f0d5","part":{"id":"prt_0","type":"step-start"}}
{"type":"tool_use","timestamp":1790777186690,"sessionID":"ses_f0d5","part":{"type":"tool","tool":"bash","callID":"call-f8","state":{"status":"completed","input":{"command":"ls"},"output":"a.txt\n","metadata":{"output":"a.txt\n","exit":0,"truncated":false},"title":"ls"},"id":"prt_1"}}
{"type":"tool_use","timestamp":1790777213777,"sessionID":"ses_f0d5","part":{"type":"tool","tool":"bash","callID":"call-f9","state":{"status":"completed","input":{"command":"false"},"output":"(no output)","metadata":{"exit":1},"title":"false"},"id":"prt_2"}}
{"type":"tool_use","timestamp":1790777194016,"sessionID":"ses_f0d5","part":{"type":"tool","tool":"read","callID":"call-57","state":{"status":"error","input":{"filePath":"/src/b.txt"},"error":"File not found"},"id":"prt_3"}}
{"type":"step_finish","timestamp":1790777194430,"sessionID":"ses_f0d5","part":{"id":"prt_4","reason":"tool-calls","type":"step-finish"}}
{"type":"text","timestamp":1790777197474,"sessionID":"ses_f0d5","part":{"id":"prt_5","type":"text","text":"hi"}}
{"type":"error","timestamp":1790777205145,"sessionID":"ses_f0d5","error":{"name":"UnknownError","data":{"message":"Unexpected server error."}}}
""";

// A Claude message repeats its usage per block; `result` has the turn's.
comptime let kClaudeSpend: str = r"""
{"type":"assistant","message":{"id":"msg_1","content":[{"type":"thinking","thinking":""}],"usage":{"input_tokens":10,"cache_creation_input_tokens":9625,"cache_read_input_tokens":13541,"output_tokens":4}}}
{"type":"assistant","message":{"id":"msg_1","content":[{"type":"text","text":"ok"}],"usage":{"input_tokens":10,"cache_creation_input_tokens":9625,"cache_read_input_tokens":13541,"output_tokens":4}}}
{"type":"assistant","message":{"id":"msg_2","content":[{"type":"text","text":"sub"}],"usage":{"input_tokens":5,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"output_tokens":5}}}
{"type":"assistant","message":{"id":"msg_1","content":[{"type":"text","text":"again"}],"usage":{"input_tokens":10,"cache_creation_input_tokens":9625,"cache_read_input_tokens":13541,"output_tokens":4}}}
{"type":"result","subtype":"success","is_error":false,"total_cost_usd":0.0207991,"usage":{"input_tokens":10,"cache_creation_input_tokens":9625,"cache_read_input_tokens":13541,"output_tokens":37}}
""";

// A call's line, the same line again as Codex repeats it at times, and
// the next call.
comptime let kRollout: str = r"""
{"timestamp":"2026-09-30T14:36:19.989Z","type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"total_tokens":1000},"last_token_usage":{"total_tokens":400}},"rate_limits":{"primary":{"used_percent":73.0,"window_minutes":10080,"resets_at":1791143267},"plan_type":"prolite"}}}
{"timestamp":"2026-09-30T14:36:20.000Z","type":"response_item","payload":{"type":"message"}}
{"timestamp":"2026-09-30T14:36:21.000Z","type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"total_tokens":1000},"last_token_usage":{"total_tokens":400}},"rate_limits":{"primary":{"used_percent":73.0,"window_minutes":10080,"resets_at":1791143267},"plan_type":"prolite"}}}
{"timestamp":"2026-09-30T14:36:25.000Z","type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"total_tokens":1250},"last_token_usage":{"total_tokens":250}},"rate_limits":{"primary":{"used_percent":74.0,"window_minutes":10080,"resets_at":1791143267},"plan_type":"prolite"}}}
""";

comptime let kOpenCodeSpend: str = r"""
{"type":"step_finish","timestamp":1790777187192,"sessionID":"ses_f0d5","part":{"id":"prt_4","reason":"tool-calls","type":"step-finish","tokens":{"total":10457,"input":8510,"output":27,"reasoning":0,"cache":{"write":0,"read":1920}},"cost":0.002}}
""";

// A terminal session's transcript: a typed prompt, injected context, a
// subagent's line, a tool call and its result, and the answer.
comptime let kTerminal: str = r"""
{"type":"user","isMeta":null,"origin":{"kind":"human"},"uuid":"u1","message":{"role":"user","content":"count the files"},"sessionId":"bcef"}
{"type":"user","isMeta":true,"uuid":"u2","message":{"role":"user","content":[{"type":"text","text":"[Image: original 1272x2772]"}]}}
{"type":"assistant","isSidechain":true,"uuid":"a0","message":{"content":[{"type":"text","text":"subagent says"}]}}
{"type":"assistant","uuid":"a1","message":{"content":[{"type":"tool_use","id":"toolu_07","name":"Bash","input":{"command":"ls | wc -l"}}]}}
{"type":"user","uuid":"u3","message":{"role":"user","content":[{"tool_use_id":"toolu_07","type":"tool_result","content":"33","is_error":false}]}}
{"type":"assistant","uuid":"a2","message":{"content":[{"type":"thinking","thinking":""},{"type":"text","text":"33 files."}]}}
{"type":"attachment","uuid":"q1","attachment":{"type":"queued_command","prompt":"only .kt","origin":{"kind":"human"}}}
{"type":"ai-title","aiTitle":"Count files","sessionId":"bcef"}
""";

// A Read of a screenshot, and a terminal prompt with a pasted image.
comptime let kImages: str = r"""
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_09","type":"tool_result","content":[{"type":"image","source":{"type":"base64","media_type":"image/png","data":"iVBORw0KGgo="}}]}]},"session_id":"2896"}
""";

comptime let kPasted: str = r"""
{"type":"user","origin":{"kind":"human"},"uuid":"u7","message":{"role":"user","content":[{"type":"image","source":{"type":"base64","media_type":"image/jpeg","data":"/9j/4AAQ"}},{"type":"text","text":"what is this?"}]}}
""";

fn check(ok: bool, what: str, var failures&: i32): () {
  if (!ok) {
    eprintln(what);
    failures += 1;
  }
}

// Every entry the lines give, as JSON text without the timestamps.
fn run(text: str, agent: str, var t&: Transcript): List<String> {
  var out = List::<String>();
  for (let line in lines(text)) {
    let j = parse(line) else {
      continue;
    };
    let entries = agent == "claude" ? read_claude(t, j) : agent == "codex" ? read_codex(t, j)
      : agent == "opencode" ? read_opencode(t, j) : read_terminal(t, j);
    for (let e& in entries) {
      out.push(to_string(without_at(e)));
    }
  }
  return out;
}

fn without_at(e&: Json): Json {
  var copy = parse(to_string(e).as_str())!;
  match (copy) {
    Json::Obj(var members&) => {
      var i: usize = 0;
      while (i < members.len()) {
        if (members[i].key.as_str() == "at") {
          let _ = members.remove(i);
        } else {
          i += 1;
        }
      }
    }
    _ => {}
  }
  return copy;
}

pub fn main(): i32 {
  var failures: i32 = 0;

  var c = Transcript("t1", "");
  let ce = run(kClaude, "claude", c);
  check(c.session.as_str() == "2896", "claude session", failures);
  check(ce.len() == 4, "claude entry count", failures);
  check(ce[0].as_str() == "{\"id\":\"t1.toolu_01\",\"kind\":\"tool\",\"tool\":\"Bash\",\"detail\":\"ls\",\"state\":\"running\"}",
        "claude tool start", failures);
  check(ce[1].as_str() == "{\"id\":\"t1.toolu_01\",\"state\":\"ok\",\"output\":\"a.txt\"}", "claude tool result", failures);
  check(ce[2].as_str() == "{\"id\":\"t1.m1\",\"kind\":\"agent\",\"text\":\"File.\"}", "claude text", failures);
  check(ce[3].as_str() == "{\"id\":\"t1.m2\",\"kind\":\"note\",\"text\":\"Claude was not allowed to use Bash: rm -rf build\"}",
        "claude permission denial", failures);
  check(!c.failed, "claude succeeded", failures);

  var x = Transcript("t2", "");
  let xe = run(kCodex, "codex", x);
  check(x.session.as_str() == "01a0", "codex session", failures);
  check(xe.len() == 4, "codex entry count", failures);
  check(xe[1].as_str() == "{\"id\":\"t2.item_1\",\"kind\":\"tool\",\"tool\":\"shell\",\"detail\":\"ls\",\"state\":\"running\"}",
        "codex command start", failures);
  check(xe[2].as_str() == "{\"id\":\"t2.item_1\",\"state\":\"ok\",\"output\":\"a.txt\\n\"}", "codex command end", failures);
  check(xe[3].as_str() == "{\"id\":\"t2.item_2\",\"kind\":\"agent\",\"text\":\"Done\"}", "codex text", failures);

  var oc = Transcript("t4", "");
  let oe = run(kOpenCode, "opencode", oc);
  check(oc.session.as_str() == "ses_f0d5", "opencode session", failures);
  check(oe.len() == 8, "opencode entry count", failures);
  check(oe.len() == 8 && oe[0].as_str() == "{\"id\":\"t4.prt_1\",\"kind\":\"tool\",\"tool\":\"bash\",\"detail\":\"ls\",\"state\":\"running\"}",
        "opencode tool start", failures);
  check(oe.len() == 8 && oe[1].as_str() == "{\"id\":\"t4.prt_1\",\"state\":\"ok\",\"output\":\"a.txt\\n\"}", "opencode tool end", failures);
  check(oe.len() == 8 && oe[3].as_str() == "{\"id\":\"t4.prt_2\",\"state\":\"error\",\"output\":\"(no output)\"}",
        "opencode command that exited non-zero", failures);
  check(oe.len() == 8 && oe[4].as_str() == "{\"id\":\"t4.prt_3\",\"kind\":\"tool\",\"tool\":\"read\",\"detail\":\"/src/b.txt\",\"state\":\"running\"}",
        "opencode file tool start", failures);
  check(oe.len() == 8 && oe[5].as_str() == "{\"id\":\"t4.prt_3\",\"state\":\"error\",\"output\":\"File not found\"}",
        "opencode tool error", failures);
  check(oe.len() == 8 && oe[6].as_str() == "{\"id\":\"t4.prt_5\",\"kind\":\"agent\",\"text\":\"hi\"}", "opencode text", failures);
  check(oe.len() == 8 && oe[7].as_str() == "{\"id\":\"t4.m1\",\"kind\":\"error\",\"text\":\"Unexpected server error.\"}",
        "opencode error", failures);
  check(oc.failed, "opencode error fails the turn", failures);

  var cs = Transcript("t5", "");
  let _ = run(kClaudeSpend, "claude", cs);
  check(cs.tokens == 23213.0, "claude counts each message once, interleaved too, then what result adds", failures);
  check(cs.cost > 0.02079 && cs.cost < 0.02081, "claude's cost comes with result", failures);
  check(x.tokens == 33352.0, "codex without a rollout counts turn.completed", failures);
  var xr = Transcript("t6", "");
  xr.rollout = true;
  var calls: u32 = 0;
  for (let line in lines(kRollout)) {
    if (let j = parse(line)) {
      if (let m = read_rollout(xr, j)) {
        calls += 1;
        check(m.limits.len() == 1, "a rollout call carries the limits", failures);
      }
    }
  }
  check(calls == 3 && xr.tokens == 1250.0, "a new session counts its total, a repeated line once", failures);
  let _ = run(kCodex, "codex", xr);
  check(xr.tokens == 1250.0, "with a rollout, turn.completed adds nothing", failures);
  var resumed = Transcript("t8", "01a0");
  resumed.rollout = true;
  resumed.codex_total = 900.0;
  for (let line in lines(kRollout)) {
    if (let j = parse(line)) {
      let _ = read_rollout(resumed, j);
    }
  }
  check(resumed.tokens == 350.0, "a resumed session counts from its total so far", failures);
  var os = Transcript("t7", "");
  let _ = run(kOpenCodeSpend, "opencode", os);
  check(os.tokens == 10457.0 && os.cost > 0.00199 && os.cost < 0.00201, "opencode counts each step", failures);

  var w = Transcript("w", "bcef");
  let we = run(kTerminal, "terminal", w);
  check(we.len() == 5, "terminal entry count", failures);
  check(we[4].as_str() == "{\"id\":\"w.q1\",\"kind\":\"user\",\"text\":\"only .kt\"}", "terminal message typed while busy", failures);
  check(we[0].as_str() == "{\"id\":\"w.u1\",\"kind\":\"user\",\"text\":\"count the files\"}", "terminal prompt", failures);
  check(we[1].as_str() == "{\"id\":\"w.toolu_07\",\"kind\":\"tool\",\"tool\":\"Bash\",\"detail\":\"ls | wc -l\",\"state\":\"running\"}",
        "terminal tool start", failures);
  check(we[2].as_str() == "{\"id\":\"w.toolu_07\",\"state\":\"ok\",\"output\":\"33\"}", "terminal tool result", failures);
  check(we[3].as_str() == "{\"id\":\"w.a2.1\",\"kind\":\"agent\",\"text\":\"33 files.\"}", "terminal answer", failures);

  var ci = Transcript("t3", "");
  let ie = run(kImages, "claude", ci);
  check(ie.len() == 1 && ie[0].as_str() == "{\"id\":\"t3.toolu_09\",\"state\":\"ok\",\"output\":\"\",\"images\":[{\"type\":\"image/png\",\"data\":\"iVBORw0KGgo=\"}]}",
        "a tool result keeps its image", failures);

  var tp = Transcript("w", "bcef");
  let pe = run(kPasted, "terminal", tp);
  check(pe.len() == 2, "a pasted image and its prompt", failures);
  check(pe.len() == 2 && pe[0].as_str() == "{\"id\":\"w.u7\",\"kind\":\"user\",\"text\":\"\",\"images\":[{\"type\":\"image/jpeg\",\"data\":\"/9j/4AAQ\"}]}",
        "the pasted image comes first", failures);
  check(pe.len() == 2 && pe[1].as_str() == "{\"id\":\"w.u7.1\",\"kind\":\"user\",\"text\":\"what is this?\"}", "then the prompt", failures);

  var pairs = List::<(str, str)>();
  pairs.push(("image/png", "iVBORw0KGgo="));
  let input = claude_input("what color?", pairs.as_slice());
  check(input.as_str() == "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"image\",\"source\":{\"type\":\"base64\",\"media_type\":\"image/png\",\"data\":\"iVBORw0KGgo=\"}},{\"type\":\"text\",\"text\":\"what color?\"}]}}\n",
        "Claude's stdin message: images, then the prompt", failures);
  return failures;
}
