// Typed reads of JSON object members, and the in-place updates akikit's
// json module lacks: replacing a member and merging one object into another.

module wire::fields;

import {String, from_str} from akikit::strings::string;
import {Json, Member, get, as_str, as_num, as_bool} from akikit::text::json;

pub fn str_of<'a>(j: &'a Json, key: str): str<'a>? {
  let v = get(j, key) else {
    return none;
  };
  return as_str(v);
}

pub fn num_of(j: &Json, key: str): f64? {
  let v = get(j, key) else {
    return none;
  };
  return as_num(v);
}

pub fn bool_of(j: &Json, key: str): bool? {
  let v = get(j, key) else {
    return none;
  };
  return as_bool(v);
}

pub fn string_of(j: &Json, key: str): String => from_str(str_of(j, key) ?? "");

// Sets key to value, replacing the member if there is one.
pub fn put(var obj&: Json, key: str, value: Json) {
  let Json::Obj(var members&) = obj else { return; };
  for (var member& in members) {
    if (member.key == key) {
      member = Member { key: from_str(key), value };
      return;
    }
  }
  members.push(Member { key: from_str(key), value });
}

// Puts every member of patch into obj, preserving duplicate-key semantics.
pub fn merge(var obj&: Json, patch: Json) {
  let Json::Obj(var members) = patch else { return; };
  while (let member = members.pop()) {
    put(obj, member.key, member.value);
  }
}
