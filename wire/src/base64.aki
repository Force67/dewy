module wire::base64;

// Standard base64 with padding, as agents and HTTP clients write it.

import {String} from akikit::strings::string;
import {List} from akikit::containers::list;

comptime let kAlphabet: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

pub fn encode(data: bytes): String {
  var out = String();
  out.reserve((#data + 2) / 3 * 4);
  var i: usize = 0;
  while (i + 2 < #data) {
    let n = ((data[i] as u32) << 16) | ((data[i + 1] as u32) << 8) | (data[i + 2] as u32);
    out.push_c8(kAlphabet[(n >> 18) as usize & 63]);
    out.push_c8(kAlphabet[(n >> 12) as usize & 63]);
    out.push_c8(kAlphabet[(n >> 6) as usize & 63]);
    out.push_c8(kAlphabet[n as usize & 63]);
    i += 3;
  }
  let rest = #data - i;
  if (rest > 0) {
    var n = (data[i] as u32) << 16;
    if (rest == 2) {
      n = n | ((data[i + 1] as u32) << 8);
    }
    out.push_c8(kAlphabet[(n >> 18) as usize & 63]);
    out.push_c8(kAlphabet[(n >> 12) as usize & 63]);
    out.push_c8(rest == 2 ? kAlphabet[(n >> 6) as usize & 63] : '=');
    out.push_c8('=');
  }
  return out;
}

fn value(c: c8): i32 {
  if (c >= 'A' && c <= 'Z') {
    return (c as i32) - ('A' as i32);
  }
  if (c >= 'a' && c <= 'z') {
    return (c as i32) - ('a' as i32) + 26;
  }
  if (c >= '0' && c <= '9') {
    return (c as i32) - ('0' as i32) + 52;
  }
  if (c == '+') {
    return 62;
  }
  if (c == '/') {
    return 63;
  }
  return -1;
}

// None when text is not base64. Whitespace is skipped, padding optional.
pub fn decode(text: str): List<byte>? {
  var out = List::<byte>();
  out.reserve(#text / 4 * 3);
  var acc: u32 = 0;
  var bits: u32 = 0;
  for (let c in text) {
    if (c == '=' || c == '\n' || c == '\r' || c == ' ') {
      continue;
    }
    let v = value(c);
    if (v < 0) {
      return none;
    }
    acc = (acc << 6) | (v as u32);
    bits += 6;
    if (bits >= 8) {
      bits -= 8;
      out.push(((acc >> bits) & 0xff) as byte);
    }
  }
  return out;
}
