// Write through a sibling file so readers see the old or the new contents.
module wire::files;

import {FileError} from akikit::filesystem::file;
import {write_file, rename_file} from akikit::filesystem::file_util;

pub fn atomic_write(path: str, body: str): () ! FileError {
  let temporary = f"{path}.tmp";
  try write_file(temporary, body);
  return rename_file(temporary, path);
}
