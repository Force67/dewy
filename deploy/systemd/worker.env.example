# Copy the orchestrator's token here.
DEWY_TOKEN=
DEWY_ORCHESTRATOR=127.0.0.1:8788

# A git repository, or directories containing repositories; colon-separated.
# Use absolute paths. EnvironmentFile does not expand $HOME, $PATH, or ~.
DEWY_PROJECTS=

# The installer appends the current shell's PATH on first installation.
# Include tmux, your agents, and the tools those agents need.
# Add any agent-specific environment variables here too.
